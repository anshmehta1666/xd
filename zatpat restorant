      async authorize(sessionToken, requiredPermission = null, ownerOnly = false) {
        if (!sessionToken) {
          throw new Error('401 Unauthorized: Active login session required.');
        }
        const session = await DB.getById('sessions', sessionToken);
        if (!session || session.expiresAt < Date.now()) {
          if (session) await DB.delete('sessions', sessionToken);
          throw new Error('401 Session Expired: Please log in again.');
        }
        const user = await DB.getById('users', session.userId);
        if (!user || !user.active) {
          throw new Error('403 Forbidden: Account is inactive or missing.');
        }
        if (ownerOnly && user.role !== 'OWNER') {
          await this.logAudit(user.name, user.role, 'UNAUTHORIZED_OWNER_ATTEMPT', 'security', requiredPermission || 'OWNER_RESOURCE', 'Blocked non-owner access');
          throw new Error('403 Forbidden: Owner privileges required.');
        }
        if (requiredPermission && user.role !== 'OWNER') {
          const perms = user.permissions || {};
          if (!perms[requiredPermission]) {
            await this.logAudit(user.name, user.role, 'PERMISSION_DENIED', 'security', requiredPermission, 'Blocked unauthorized action');
            throw new Error(`403 Forbidden: Missing "${requiredPermission}" permission.`);
          }
        }
        return user;
      }

      /**
       * EXACT ZATPATGO PLATFORM FEE & RESTAURANT COMMISSION FORMULA
       */
      calculateOrderFinancials(foodSubtotalInput) {
        const subtotal = Math.round(Number(foodSubtotalInput) * 100) / 100;
        const threshold = 100;
        let customerPlatformFee = 0;
        let customerFeeRate = 0;
        let restaurantCommission = 0;
        let restaurantCommissionRate = 0;

        if (subtotal < threshold) {
          customerPlatformFee = 15;
          customerFeeRate = 0;
          restaurantCommission = 0;
          restaurantCommissionRate = 0;
        } else {
          customerFeeRate = 0.05;
          restaurantCommissionRate = 0.15;
          customerPlatformFee = Math.round(subtotal * customerFeeRate * 100) / 100;
          restaurantCommission = Math.round(subtotal * restaurantCommissionRate * 100) / 100;
        }

        const customerPayable = Math.round((subtotal + customerPlatformFee) * 100) / 100;
        const restaurantSettlement = Math.round((subtotal - restaurantCommission) * 100) / 100;
        const totalPlatformEarning = Math.round((customerPlatformFee + restaurantCommission) * 100) / 100;

        return {
          calculationVersion: 'ZATPATGO_385340_FEE_V2',
          threshold,
          foodSubtotal: subtotal,
          customerFeeRate,
          customerPlatformFee,
          customerPayable,
          restaurantCommissionRate,
          restaurantCommission,
          restaurantSettlement,
          totalPlatformEarning
        };
      }

