    /**
     * =========================================================================
     * 11. AUTOMATIC ORDER MANAGEMENT & BUSY MODE CONFIGURATION MODAL
     * =========================================================================
     */
    const AutomationConfigModal = ({ open, onClose, autoSettings, settings, onSaveAuto, onSaveBusy }) => {
      const [form, setForm] = useState(autoSettings);
      const [busyForm, setBusyForm] = useState({
        enabled: settings?.busyMode?.enabled || false,
        durationMinutes: 30,
        extraPrepMinutes: settings?.busyMode?.extraPrepMinutes || 12,
        reducedMaxOrders: settings?.busyMode?.reducedMaxOrders || 4,
        pauseNewOrders: settings?.busyMode?.pauseNewOrders || false
      });

      useEffect(() => {
        if (autoSettings) setForm(autoSettings);
        if (settings?.busyMode) {
          setBusyForm(prev => ({
            ...prev,
            enabled: settings.busyMode.enabled,
            extraPrepMinutes: settings.busyMode.extraPrepMinutes,
            reducedMaxOrders: settings.busyMode.reducedMaxOrders,
            pauseNewOrders: settings.busyMode.pauseNewOrders
          }));
        }
      }, [autoSettings, settings, open]);

      if (!form) return null;

      const handleSave = async (e) => {
        e.preventDefault();
        await onSaveAuto(form);
        await onSaveBusy(busyForm);
        onClose();
      };

      return (
        <Modal
          open={open}
          onClose={onClose}
          title="Automatic Mode & Kitchen Busy Settings"
          subtitle="7-point safety rules evaluated before auto-accepting incoming orders"
          maxWidth="max-w-xl"
        >
          <form onSubmit={handleSave} className="space-y-4">
            <div className={`p-4 rounded-2xl border ${form.autoAcceptEnabled ? 'bg-brand-purple/5 border-brand-purple/30' : 'bg-brand-canvas border-brand-hairline'}`}>
              <div className="flex items-center justify-between gap-3">
                <div>
                  <div className="font-editorial font-extrabold text-sm text-brand-ink flex items-center gap-1.5">
                    <Icon name="bolt" className="w-4 h-4 text-brand-purple" />
                    <span>Automatic Order Acceptance</span>
                  </div>
                  <p className="text-xs text-brand-muted mt-0.5">
                    Automatically accepts valid paid orders when online, in stock &amp; under capacity. Food preparation &amp; ready stages remain manual.
                  </p>
                </div>
                <label className="relative inline-flex items-center cursor-pointer shrink-0">
                  <input
                    type="checkbox"
                    checked={form.autoAcceptEnabled}
                    onChange={(e) => setForm({ ...form, autoAcceptEnabled: e.target.checked })}
                    className="sr-only peer"
                  />
                  <div className="w-12 h-6 bg-brand-hairline rounded-full peer peer-checked:after:translate-x-6 after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-brand-purple" />
                </label>
              </div>
            </div>

            <div className="grid grid-cols-2 gap-3">
              <div>
                <label className="block text-[11px] font-bold uppercase text-brand-muted mb-1">Max Active Orders</label>
                <input
                  type="number"
                  min="1"
                  max="50"
                  value={form.maxSimultaneousOrders}
                  onChange={(e) => setForm({ ...form, maxSimultaneousOrders: Number(e.target.value) })}
                  className="w-full h-10 px-3 rounded-xl bg-brand-canvas border border-brand-hairline text-xs font-extrabold"
                />
              </div>
              <div>
                <label className="block text-[11px] font-bold uppercase text-brand-muted mb-1">Max Orders / Hour</label>
                <input
                  type="number"
                  min="1"
                  max="100"
                  value={form.maxOrdersPerHour}
                  onChange={(e) => setForm({ ...form, maxOrdersPerHour: Number(e.target.value) })}
                  className="w-full h-10 px-3 rounded-xl bg-brand-canvas border border-brand-hairline text-xs font-extrabold"
                />
              </div>
              <div>
                <label className="block text-[11px] font-bold uppercase text-brand-muted mb-1">Default Prep (Mins)</label>
                <input
                  type="number"
                  min="5"
                  max="60"
                  value={form.defaultPrepTimeMinutes}
                  onChange={(e) => setForm({ ...form, defaultPrepTimeMinutes: Number(e.target.value) })}
                  className="w-full h-10 px-3 rounded-xl bg-brand-canvas border border-brand-hairline text-xs font-extrabold"
                />
              </div>
              <div>
                <label className="block text-[11px] font-bold uppercase text-brand-muted mb-1">Timeout Fallback</label>
                <select
                  value={form.fallbackPolicy}
                  onChange={(e) => setForm({ ...form, fallbackPolicy: e.target.value })}
                  className="w-full h-10 px-3 rounded-xl bg-brand-canvas border border-brand-hairline text-xs font-extrabold"
                >
                  <option value="MANUAL_REVIEW">Manual Review (Safe)</option>
                  <option value="AUTO_REJECT">Auto-Reject on Timeout</option>
                </select>
              </div>
            </div>

            <div className="space-y-2 pt-2 border-t border-brand-hairline text-xs">
              <label className="flex items-center justify-between font-semibold text-brand-ink cursor-pointer">
                <span>Auto-pause kitchen when capacity reached</span>
                <input
                  type="checkbox"
                  checked={form.autoPauseOnCapacityReached}
                  onChange={(e) => setForm({ ...form, autoPauseOnCapacityReached: e.target.checked })}
                  className="w-4 h-4 accent-brand-purple"
                />
              </label>
              <label className="flex items-center justify-between font-semibold text-brand-ink cursor-pointer">
                <span>Auto-mark product unavailable when stock hits 0</span>
                <input
                  type="checkbox"
                  checked={form.autoMarkOutOfStockAtZero}
                  onChange={(e) => setForm({ ...form, autoMarkOutOfStockAtZero: e.target.checked })}
                  className="w-4 h-4 accent-brand-purple"
                />
              </label>
            </div>

            <div className="p-4 rounded-2xl bg-brand-yellow/25 border border-brand-yellow space-y-3">
              <div className="flex items-center justify-between">
                <div className="font-editorial font-extrabold text-sm text-brand-ink flex items-center gap-1.5">
                  <Icon name="flame" className="w-4 h-4 text-brand-orange" />
                  <span>Kitchen Busy Mode</span>
                </div>
                <label className="relative inline-flex items-center cursor-pointer">
                  <input
                    type="checkbox"
                    checked={busyForm.enabled}
                    onChange={(e) => setBusyForm({ ...busyForm, enabled: e.target.checked })}
                    className="sr-only peer"
                  />
                  <div className="w-11 h-6 bg-brand-ink/15 rounded-full peer peer-checked:after:translate-x-5 after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-brand-orange" />
                </label>
              </div>
              <div className="grid grid-cols-3 gap-2 text-xs">
                <div>
                  <label className="block text-[10px] font-bold uppercase text-brand-muted mb-1">Duration</label>
                  <select
                    value={busyForm.durationMinutes}
                    onChange={(e) => setBusyForm({ ...busyForm, durationMinutes: Number(e.target.value) })}
                    className="w-full h-9 px-2 rounded-xl bg-white border border-brand-hairline font-bold"
                  >
                    <option value={15}>15 mins</option>
                    <option value={30}>30 mins</option>
                    <option value={60}>60 mins</option>
                    <option value={0}>Until disabled</option>
                  </select>
                </div>
                <div>
                  <label className="block text-[10px] font-bold uppercase text-brand-muted mb-1">+Prep (m)</label>
                  <input
                    type="number"
                    min="5"
                    max="45"
                    value={busyForm.extraPrepMinutes}
                    onChange={(e) => setBusyForm({ ...busyForm, extraPrepMinutes: Number(e.target.value) })}
                    className="w-full h-9 px-2 rounded-xl bg-white border border-brand-hairline font-bold"
                  />
                </div>
                <div>
                  <label className="block text-[10px] font-bold uppercase text-brand-muted mb-1">Cap Limit</label>
                  <input
                    type="number"
                    min="1"
                    max="20"
                    value={busyForm.reducedMaxOrders}
                    onChange={(e) => setBusyForm({ ...busyForm, reducedMaxOrders: Number(e.target.value) })}
                    className="w-full h-9 px-2 rounded-xl bg-white border border-brand-hairline font-bold"
                  />
                </div>
              </div>
            </div>

            <button
              type="submit"
              className="w-full h-12 rounded-2xl bg-brand-purple hover:bg-brand-deep text-white font-editorial font-extrabold text-sm shadow-pill btn-tactile"
            >
              Save Automation Rules
            </button>
          </form>
        </Modal>
      );
    };

    /**
     * =========================================================================
     * 12. HOME DASHBOARD SCREEN (ROLE-ADAPTED COMMAND CENTER)
     * =========================================================================
     */
    const HomeDashboard = ({
      currentUser,
      restaurants,
      activeRestaurant,
      onSwitchRestaurant,
      settings,
      autoSettings,
      orders,
      onToggleOnline,
      onToggleBusyQuick,
      onOpenAutomation,
      onOpenSimulator,
      onOrderAction,
      onInspectOrder,
      onNavigate
    }) => {
      const [offlineModalOpen, setOfflineModalOpen] = useState(false);
      const [offlineReason, setOfflineReason] = useState('Kitchen rush / High walk-in crowd');
      const [pauseMinutes, setPauseMinutes] = useState(30);
      const isOwner = currentUser?.role === 'OWNER';

      const startOfToday = new Date();
      startOfToday.setHours(0, 0, 0, 0);
      const todayTs = startOfToday.getTime();

      const todaysOrders = orders.filter(o => o.createdAt >= todayTs);
      const validToday = todaysOrders.filter(o => !['CANCELLED', 'REJECTED', 'REFUNDED'].includes(o.status));
      const todaysSales = validToday.reduce((s, o) => s + o.foodSubtotal, 0);

      const newOrders = orders.filter(o => o.status === 'NEW');
      const acceptedOrders = orders.filter(o => o.status === 'ACCEPTED');
      const preparingOrders = orders.filter(o => o.status === 'PREPARING');
      const readyOrders = orders.filter(o => o.status === 'READY');
      const onTheWayOrders = orders.filter(o => o.status === 'ON_THE_WAY');

      const pendingCount = newOrders.length + acceptedOrders.length + preparingOrders.length + readyOrders.length;
      const isBusy = settings?.busyMode?.enabled && (!settings.busyMode.expiresAt || settings.busyMode.expiresAt > Date.now());
      const maxCap = isBusy ? settings.busyMode.reducedMaxOrders : (autoSettings?.maxSimultaneousOrders || 8);

      const handleAvailabilityTap = () => {
        if (!isOwner) return;
        triggerHaptic();
        if (settings?.isOnline) setOfflineModalOpen(true);
        else onToggleOnline({ isOnline: true });
      };

      const confirmOffline = async (e) => {
        e.preventDefault();
        await onToggleOnline({
          isOnline: false,
          offlineReason,
          pauseMinutes: pauseMinutes === 0 ? null : pauseMinutes
        });
        setOfflineModalOpen(false);
      };

      return (
        <div className="space-y-5 animate-fade-up">
          {/* Default PIN Security Reminder Banner for Owner */}
          {isOwner && activeRestaurant?.requiresDefaultPinChange && (
            <div className="p-3.5 rounded-2xl bg-brand-yellow/35 border border-brand-yellow flex flex-col tablet:flex-row tablet:items-center justify-between gap-2.5">
              <div className="flex items-center gap-2 text-xs text-brand-ink">
                <Icon name="shield" className="w-4 h-4 text-brand-purple shrink-0" />
                <span>
                  <strong>Security Notice:</strong> Initial development Owner PIN is active. Change your 6-digit Security PIN in Profile before production deployment.
                </span>
              </div>
              <button
                type="button"
                onClick={() => onNavigate('PROFILE')}
                className="h-8 px-3.5 rounded-full bg-brand-purple text-white text-[11px] font-extrabold shrink-0 self-start tablet:self-auto btn-tactile"
              >
                Update PIN
              </button>
            </div>
          )}

          {/* Top Kitchen Switcher Strip (Owner only; Staff locked to assigned kitchen) */}
          {isOwner && (
            <div className="flex items-center gap-2 overflow-x-auto no-scrollbar pb-1">
              {restaurants.map(r => {
                const selected = r.id === activeRestaurant?.id;
                return (
                  <button
                    key={r.id}
                    type="button"
                    onClick={() => onSwitchRestaurant(r.id)}
                    className={`h-9 px-3.5 rounded-full text-xs font-extrabold whitespace-nowrap transition btn-tactile ${
                      selected
                        ? 'bg-brand-purple text-white shadow-pill'
                        : 'bg-white border border-brand-hairline text-brand-ink hover:border-brand-purple/40'
                    }`}
                  >
                    {r.name}
                  </button>
                );
              })}
            </div>
          )}

          {/* Primary Restaurant Status & KPI Card */}
          <section className="bg-white rounded-[26px] p-4 tablet:p-6 border border-brand-hairline shadow-editorial space-y-4">
            <div className="flex flex-col tablet:flex-row tablet:items-center justify-between gap-4">
              <div className="flex items-center gap-3.5">
                <div className="relative shrink-0">
                  <img
                    src={activeRestaurant?.heroImage}
                    onerror={`this.src='${FALLBACK_FOOD_IMG}'`}
                    alt={activeRestaurant?.name}
                    className="w-14 h-14 rounded-2xl object-cover border border-brand-hairline"
                  />
                  <span className={`w-3.5 h-3.5 rounded-full border-2 border-white absolute -bottom-1 -right-1 ${settings?.isOnline ? 'bg-emerald-500' : 'bg-brand-orange'}`} />
                </div>
                <div>
                  <div className="flex items-center gap-2 flex-wrap">
                    <h1 className="font-editorial font-extrabold text-xl tablet:text-2xl text-brand-ink">
                      {activeRestaurant?.name}
                    </h1>
                    <span className="px-2.5 py-0.5 rounded-full bg-brand-purple/10 text-brand-purple text-[10px] font-extrabold uppercase">
                      {currentUser?.roleLabel}
                    </span>
                    {isBusy && (
                      <span className="px-2.5 py-0.5 rounded-full bg-brand-yellow text-brand-ink text-[10px] font-extrabold uppercase tracking-wider">
                        BUSY MODE (+{settings.busyMode.extraPrepMinutes}M)
                      </span>
                    )}
                  </div>
                  <div className="flex items-center gap-2 mt-1 flex-wrap text-xs">
                    {isOwner ? (
                      <button
                        type="button"
                        onClick={onOpenAutomation}
                        className={`inline-flex items-center gap-1.5 px-3 py-1 rounded-full font-extrabold border transition btn-tactile ${
                          autoSettings?.autoAcceptEnabled
                            ? 'bg-brand-purple text-white border-brand-purple shadow-pill'
                            : 'bg-brand-canvas text-brand-ink border-brand-hairline'
                        }`}
                      >
                        <Icon name="bolt" className="w-3.5 h-3.5" />
                        <span>Mode: {autoSettings?.autoAcceptEnabled ? 'Automatic' : 'Manual'}</span>
                      </button>
                    ) : (
                      <span className="inline-flex items-center gap-1.5 px-3 py-1 rounded-full font-extrabold bg-brand-canvas text-brand-ink border border-brand-hairline">
                        <Icon name="bolt" className="w-3.5 h-3.5 text-brand-purple" />
                        <span>Mode: {autoSettings?.autoAcceptEnabled ? 'Automatic' : 'Manual'}</span>
                      </span>
                    )}
                    <span className="text-brand-muted font-semibold">
                      Hours: {settings?.scheduledOpenTime} – {settings?.scheduledCloseTime}
                    </span>
                  </div>
                </div>
              </div>

              {/* Busy Mode + ONLINE/OFFLINE Toggle (Interactive for Owner; Read-Only Badge for Staff) */}
              <div className="flex items-center gap-2 flex-wrap">
                {isOwner && (
                  <button
                    type="button"
                    onClick={onToggleBusyQuick}
                    className={`h-11 px-4 rounded-full text-xs font-extrabold border transition flex items-center gap-1.5 btn-tactile ${
                      isBusy
                        ? 'bg-brand-yellow text-brand-ink border-brand-yellow shadow-2xs'
                        : 'bg-brand-canvas text-brand-ink border-brand-hairline hover:border-brand-purple/40'
                    }`}
                  >
                    <Icon name="flame" className="w-4 h-4 text-brand-orange" />
                    <span>{isBusy ? 'Busy ON' : 'Busy Mode'}</span>
                  </button>
                )}

                <button
                  type="button"
                  disabled={!isOwner}
                  onClick={handleAvailabilityTap}
                  className={`h-11 px-5 rounded-full text-xs font-extrabold transition flex items-center gap-2 ${
                    settings?.isOnline
                      ? 'bg-brand-purple text-white shadow-pill'
                      : 'bg-brand-orange text-white shadow-orange-glow'
                  } ${isOwner ? 'btn-tactile cursor-pointer' : 'opacity-90 cursor-default'}`}
                >
                  <span className={`w-2 h-2 rounded-full ${settings?.isOnline ? 'bg-brand-yellow animate-pulse' : 'bg-white'}`} />
                  <span>{settings?.isOnline ? 'ONLINE' : 'OFFLINE'}</span>
                </button>
              </div>
            </div>

            {/* Offline Alert Banner */}
            {!settings?.isOnline && (
              <div className="p-4 rounded-2xl bg-brand-orange/10 border border-brand-orange/30 flex flex-col tablet:flex-row tablet:items-center justify-between gap-3">
                <div className="flex items-start gap-2.5">
                  <Icon name="alert" className="w-5 h-5 text-brand-orange shrink-0 mt-0.5" />
                  <div>
                    <div className="text-xs font-extrabold text-brand-ink">
                      Kitchen Offline — New customer orders paused in Radhanpur 385340
                    </div>
                    <div className="text-xs text-brand-muted mt-0.5">
                      Reason: {settings?.offlineReason} {settings?.pausedUntil ? `• Auto-resumes at ${formatTime(settings.pausedUntil)}` : ''}
                    </div>
                  </div>
                </div>
                {isOwner && (
                  <button
                    type="button"
                    onClick={() => onToggleOnline({ isOnline: true })}
                    className="h-10 px-4 rounded-full bg-brand-purple text-white text-xs font-extrabold shrink-0 shadow-pill btn-tactile"
                  >
                    Resume Online
                  </button>
                )}
              </div>
            )}

            {/* Today's 4 Core KPI Cards (Financial Revenue visible ONLY to Owner) */}
            <div className="pt-3 border-t border-brand-canvas grid grid-cols-2 desktop:grid-cols-4 gap-3">
              <div className="p-3.5 rounded-2xl bg-brand-canvas border border-brand-hairline">
                <span className="text-[11px] font-bold text-brand-muted">Today's Orders</span>
                <div className="font-editorial font-extrabold text-2xl text-brand-ink mt-0.5">{todaysOrders.length}</div>
              </div>
              {isOwner ? (
                <div className="p-3.5 rounded-2xl bg-brand-canvas border border-brand-hairline">
                  <span className="text-[11px] font-bold text-brand-muted">Today's Food Sales</span>
                  <div className="font-editorial font-extrabold text-2xl text-brand-purple mt-0.5">{formatCurrency(todaysSales)}</div>
                </div>
              ) : (
                <div className="p-3.5 rounded-2xl bg-brand-canvas border border-brand-hairline">
                  <span className="text-[11px] font-bold text-brand-muted">In Kitchen Prep</span>
                  <div className="font-editorial font-extrabold text-2xl text-brand-purple mt-0.5">{acceptedOrders.length + preparingOrders.length}</div>
                </div>
              )}
              <div className="p-3.5 rounded-2xl bg-brand-orange/10 border border-brand-orange/25">
                <span className="text-[11px] font-bold text-brand-orange">Pending Orders</span>
                <div className="font-editorial font-extrabold text-2xl text-brand-orange mt-0.5">{pendingCount}</div>
              </div>
              <div className="p-3.5 rounded-2xl bg-brand-canvas border border-brand-hairline">
                <div className="flex items-center justify-between text-[11px] font-bold text-brand-muted">
                  <span>Active Capacity</span>
                  <strong className="text-brand-ink">{pendingCount}/{maxCap}</strong>
                </div>
                <div className="w-full h-2 bg-brand-hairline rounded-full mt-2.5 overflow-hidden">
                  <div
                    className={`h-full rounded-full transition-all ${pendingCount >= maxCap ? 'bg-brand-orange' : 'bg-brand-purple'}`}
                    style={{ width: `${Math.min(100, (pendingCount / maxCap) * 100)}%` }}
                  />
                </div>
              </div>
            </div>
          </section>

          {/* Deep Purple Editorial Simulator Banner */}
          <section className="rounded-[24px] bg-brand-deep text-white p-4 tablet:p-5 flex items-center justify-between gap-3 shadow-editorial">
            <div className="min-w-0">
              <span className="px-2.5 py-0.5 rounded-full bg-brand-yellow text-brand-ink text-[10px] font-extrabold uppercase tracking-wider">
                Zatpatgo Live Bus • 385340
              </span>
              <div className="font-editorial font-extrabold text-sm tablet:text-base mt-1.5 truncate">
                Simulate incoming customer orders in real time
              </div>
            </div>
            <button
              type="button"
              onClick={onOpenSimulator}
              className="h-11 px-4 rounded-full bg-brand-yellow hover:opacity-95 text-brand-ink font-editorial font-extrabold text-xs shrink-0 flex items-center gap-1.5 btn-tactile"
            >
              <Icon name="plus" className="w-4 h-4" />
              <span>Simulate Order</span>
            </button>
          </section>

          {/* SECTION 1: INCOMING NEW ORDERS */}
          {newOrders.length > 0 && (
            <section className="space-y-3">
              <h2 className="font-editorial font-extrabold text-base tablet:text-lg text-brand-ink flex items-center gap-2">
                <span className="w-2.5 h-2.5 rounded-full bg-brand-orange animate-ping" />
                <span>Incoming New Orders ({newOrders.length})</span>
              </h2>
              <div className="grid grid-cols-1 desktop:grid-cols-2 gap-4">
                {newOrders.map(ord => (
                  <OrderCard
                    key={ord.id}
                    order={ord}
                    currentUser={currentUser}
                    timeoutSeconds={autoSettings?.manualAcceptTimeoutSeconds || 90}
                    onAction={onOrderAction}
                    onInspect={onInspectOrder}
                  />
                ))}
              </div>
            </section>
          )}

          {/* SECTION 2: ACCEPTED & PREPARING */}
          <section className="space-y-3">
            <div className="flex items-center justify-between">
              <h2 className="font-editorial font-extrabold text-base tablet:text-lg text-brand-ink">
                Kitchen Queue ({acceptedOrders.length + preparingOrders.length})
              </h2>
              <button
                type="button"
                onClick={() => onNavigate('ORDERS')}
                className="text-xs font-extrabold text-brand-purple hover:underline"
              >
                All Orders →
              </button>
            </div>

            {acceptedOrders.length + preparingOrders.length === 0 ? (
              <div className="bg-white rounded-[24px] p-8 border border-brand-hairline text-center">
                <div className="font-editorial font-extrabold text-sm text-brand-ink">No active orders in kitchen preparation</div>
                <p className="text-xs text-brand-muted mt-1">New orders from Radhanpur 385340 appear instantly without refresh.</p>
              </div>
            ) : (
              <div className="grid grid-cols-1 desktop:grid-cols-2 gap-4">
                {[...acceptedOrders, ...preparingOrders].map(ord => (
                  <OrderCard
                    key={ord.id}
                    order={ord}
                    currentUser={currentUser}
                    onAction={onOrderAction}
                    onInspect={onInspectOrder}
                  />
                ))}
              </div>
            )}
          </section>

          {/* SECTION 3: READY & ON THE WAY */}
          {(readyOrders.length > 0 || onTheWayOrders.length > 0) && (
            <section className="space-y-3">
              <h2 className="font-editorial font-extrabold text-base tablet:text-lg text-brand-ink">
                Ready for Handover &amp; Out for Delivery ({readyOrders.length + onTheWayOrders.length})
              </h2>
              <div className="grid grid-cols-1 desktop:grid-cols-2 gap-4">
                {[...readyOrders, ...onTheWayOrders].map(ord => (
                  <OrderCard
                    key={ord.id}
                    order={ord}
                    currentUser={currentUser}
                    onAction={onOrderAction}
                    onInspect={onInspectOrder}
                  />
                ))}
              </div>
            </section>
          )}

          {/* Go Offline Modal */}
          <Modal
            open={offlineModalOpen}
            onClose={() => setOfflineModalOpen(false)}
            title="Switch Kitchen Offline"
            subtitle="Active orders remain accessible while new customer orders are paused."
          >
            <form onSubmit={confirmOffline} className="space-y-4">
              <div>
                <label className="block text-[11px] font-bold uppercase text-brand-muted mb-1.5">Offline Reason</label>
                <select
                  value={offlineReason}
                  onChange={(e) => setOfflineReason(e.target.value)}
                  className="w-full h-11 px-3.5 rounded-2xl bg-brand-canvas border border-brand-hairline text-xs font-bold"
                >
                  <option value="Kitchen rush / High walk-in crowd">Kitchen rush / High walk-in crowd</option>
                  <option value="Ingredients restocking">Ingredients restocking</option>
                  <option value="Staff shift changeover">Staff shift changeover</option>
                  <option value="Closing early for the day">Closing early for the day</option>
                </select>
              </div>
              <div>
                <label className="block text-[11px] font-bold uppercase text-brand-muted mb-1.5">Auto-Reopen Timer</label>
                <div className="grid grid-cols-4 gap-2">
                  {[
                    { label: '15m', val: 15 },
                    { label: '30m', val: 30 },
                    { label: '60m', val: 60 },
                    { label: 'Manual', val: 0 }
                  ].map(opt => (
                    <button
                      key={opt.val}
                      type="button"
                      onClick={() => setPauseMinutes(opt.val)}
                      className={`h-10 rounded-xl text-xs font-extrabold border transition btn-tactile ${
                        pauseMinutes === opt.val
                          ? 'bg-brand-purple text-white border-brand-purple shadow-pill'
                          : 'bg-brand-canvas text-brand-ink border-brand-hairline'
                      }`}
                    >
                      {opt.label}
                    </button>
                  ))}
                </div>
              </div>
              <button
                type="submit"
                className="w-full h-12 rounded-2xl bg-brand-orange text-white font-editorial font-extrabold text-sm shadow-orange-glow btn-tactile"
              >
                Confirm Go Offline
              </button>
            </form>
          </Modal>
        </div>
      );
    };

    /**
     * =========================================================================
     * 13. DEDICATED ORDERS SCREEN (7 PIPELINE TABS + SEARCH)
     * =========================================================================
     */
    const OrdersScreen = ({ orders, currentUser, autoSettings, onOrderAction, onInspectOrder }) => {
      const [activeTab, setActiveTab] = useState('NEW');
      const [search, setSearch] = useState('');

      const tabs = [
        { id: 'NEW', label: 'New' },
        { id: 'ACCEPTED', label: 'Accepted' },
        { id: 'PREPARING', label: 'Preparing' },
        { id: 'READY', label: 'Ready' },
        { id: 'ON_THE_WAY', label: 'On The Way' },
        { id: 'COMPLETED', label: 'Completed' },
        { id: 'CANCELLED', label: 'Cancelled' }
      ];

      const filtered = orders.filter(o => {
        const statusOk = activeTab === 'CANCELLED'
          ? ['CANCELLED', 'REJECTED', 'REFUNDED'].includes(o.status)
          : o.status === activeTab;
        if (!statusOk) return false;
        if (!search.trim()) return true;
        const q = search.toLowerCase();
        return o.id.toLowerCase().includes(q) || o.customerName.toLowerCase().includes(q);
      });

      return (
        <div className="space-y-4 animate-fade-up">
          <div>
            <span className="text-[10px] font-extrabold uppercase tracking-[0.18em] text-brand-purple">Live Pipeline</span>
            <h1 className="font-editorial font-extrabold text-2xl tablet:text-3xl text-brand-ink mt-0.5">Order Management</h1>
          </div>

          <div className="relative">
            <span className="absolute left-3.5 top-3 text-brand-purple">
              <Icon name="search" className="w-4 h-4" />
            </span>
            <input
              type="text"
              value={search}
              onChange={(e) => setSearch(e.target.value)}
              placeholder="Search by Order ID or Customer Name..."
              className="w-full h-10 pl-10 pr-4 rounded-full bg-white border border-brand-hairline text-xs font-medium focus:border-brand-purple focus:outline-none"
            />
          </div>

          <div className="flex items-center gap-1.5 overflow-x-auto no-scrollbar pb-1">
            {tabs.map(t => {
              const count = orders.filter(o =>
                t.id === 'CANCELLED' ? ['CANCELLED', 'REJECTED', 'REFUNDED'].includes(o.status) : o.status === t.id
              ).length;
              const selected = activeTab === t.id;
              return (
                <button
                  key={t.id}
                  type="button"
                  onClick={() => { triggerHaptic(); setActiveTab(t.id); }}
                  className={`h-9 px-3.5 rounded-full text-xs font-extrabold whitespace-nowrap transition flex items-center gap-1.5 btn-tactile ${
                    selected
                      ? 'bg-brand-purple text-white shadow-pill'
                      : 'bg-white border border-brand-hairline text-brand-ink'
                  }`}
                >
                  <span>{t.label}</span>
                  <span className={`px-1.5 py-0.2 rounded-full text-[10px] ${selected ? 'bg-brand-yellow text-brand-ink' : 'bg-brand-canvas text-brand-muted'}`}>
                    {count}
                  </span>
                </button>
              );
            })}
          </div>

          {filtered.length === 0 ? (
            <div className="bg-white rounded-[24px] p-10 border border-brand-hairline text-center">
              <div className="font-editorial font-extrabold text-sm text-brand-ink">No orders in {activeTab.replace('_', ' ')}</div>
            </div>
          ) : (
            <div className="grid grid-cols-1 desktop:grid-cols-2 gap-4">
              {filtered.map(ord => (
                <OrderCard
                  key={ord.id}
                  order={ord}
                  currentUser={currentUser}
                  timeoutSeconds={autoSettings?.manualAcceptTimeoutSeconds || 90}
                  onAction={onOrderAction}
                  onInspect={onInspectOrder}
                />
              ))}
            </div>
          )}
        </div>
      );
    };

    /**
     * =========================================================================
     * 14. MENU, CATEGORY & STOCK INVENTORY MANAGEMENT SCREEN (RBAC ENFORCED)
     * =========================================================================
     */
    const MenuManagementScreen = ({ sessionToken, restaurantId, products, categories, inventoryLogs, currentUser, onRefresh, showToast }) => {
      const [subTab, setSubTab] = useState('ITEMS'); // 'ITEMS' | 'CATEGORIES' | 'STOCK'
      const [search, setSearch] = useState('');
      const [editingProduct, setEditingProduct] = useState(null);
      const [modalOpen, setModalOpen] = useState(false);

      const [newCatName, setNewCatName] = useState('');
      const [renamingId, setRenamingId] = useState(null);
      const [renamingVal, setRenamingVal] = useState('');

      const isOwner = currentUser?.role === 'OWNER';
      const canEditMenu = isOwner || !!currentUser?.permissions?.editMenu;
      const canChangePrices = isOwner || !!currentUser?.permissions?.changePrices;
      const canManageStock = isOwner || !!currentUser?.permissions?.manageStock;

      const kitchenProducts = products.filter(p => p.restaurantId === restaurantId);
      const kitchenCategories = categories.filter(c => c.restaurantId === restaurantId).sort((a, b) => a.sortOrder - b.sortOrder);
      const kitchenLogs = inventoryLogs.filter(l => l.restaurantId === restaurantId).sort((a, b) => b.timestamp - a.timestamp);

      const openNewItem = () => {
        setEditingProduct({
          id: null,
          restaurantId,
          name: '',
          description: '',
          categoryId: kitchenCategories[0]?.id || '',
          categoryName: kitchenCategories[0]?.name || 'Specials',
          price: 150,
          prepTime: 15,
          isPopular: false,
          available: true,
          stock: 20,
          lowStockThreshold: 5,
          image: FALLBACK_FOOD_IMG,
          variantsText: 'Regular',
          addonsText: ''
        });
        setModalOpen(true);
      };

      const openEditItem = (prod) => {
        setEditingProduct({
          ...prod,
          variantsText: (prod.variants || []).join(', '),
          addonsText: (prod.addons || []).join(', ')
        });
        setModalOpen(true);
      };

      const handleSaveProduct = async (e) => {
        e.preventDefault();
        if (!canEditMenu) return;
        try {
          const prodId = editingProduct.id || CryptoUtils.generateId('PRD');
          const matchedCat = kitchenCategories.find(c => c.id === editingProduct.categoryId);

          const record = {
            id: prodId,
            restaurantId,
            categoryId: editingProduct.categoryId,
            categoryName: matchedCat?.name || editingProduct.categoryName || 'Menu',
            name: editingProduct.name.trim(),
            description: editingProduct.description.trim(),
            price: Math.max(1, Number(editingProduct.price)),
            prepTime: Math.max(2, Number(editingProduct.prepTime)),
            isPopular: !!editingProduct.isPopular,
            available: Number(editingProduct.stock) > 0 ? !!editingProduct.available : false,
            stock: Math.max(0, Number(editingProduct.stock)),
            lowStockThreshold: Math.max(1, Number(editingProduct.lowStockThreshold || 5)),
            image: editingProduct.image?.trim() || FALLBACK_FOOD_IMG,
            variants: editingProduct.variantsText.split(',').map(s => s.trim()).filter(Boolean),
            addons: editingProduct.addonsText.split(',').map(s => s.trim()).filter(Boolean)
          };

          await Backend.saveMenuProduct(sessionToken, record);
          showToast(editingProduct.id ? 'Product updated' : 'Dish published to Customer App');
          setModalOpen(false);
          onRefresh();
        } catch (err) {
          showToast(err.message, 'error');
        }
      };

      const handleToggleAvailability = async (prod) => {
        if (!canEditMenu && !canManageStock) {
          showToast('Permission required to toggle item availability.', 'error');
          return;
        }
        if (!prod.available && prod.stock <= 0) {
          showToast('Restock this item above 0 before marking available.', 'error');
          return;
        }
        const updated = { ...prod, available: !prod.available };
        await DB.put('products', updated);
        await Backend.logAudit(currentUser.name, currentUser.role, 'ITEM_AVAILABILITY', 'products', prod.id, `${prod.name} -> ${updated.available}`);
        RealtimeBus.publish('CATALOG_UPDATED', { restaurantId });
        triggerHaptic();
        onRefresh();
      };

      const handleAddCategory = async (e) => {
        e.preventDefault();
        if (!newCatName.trim() || !canEditMenu) return;
        await DB.put('categories', {
          id: CryptoUtils.generateId('CAT'),
          restaurantId,
          name: newCatName.trim(),
          sortOrder: kitchenCategories.length + 1,
          enabled: true
        });
        setNewCatName('');
        showToast('Category added');
        onRefresh();
      };

      const handleSafeDeleteCategory = async (cat) => {
        const linked = kitchenProducts.filter(p => p.categoryId === cat.id).length;
        if (linked > 0) {
          showToast(`Blocked: ${linked} active menu item(s) belong to "${cat.name}". Reassign them first.`, 'error');
          return;
        }
        await DB.delete('categories', cat.id);
        showToast(`Category "${cat.name}" deleted`);
        onRefresh();
      };

      const filteredProducts = kitchenProducts.filter(p => p.name.toLowerCase().includes(search.toLowerCase()));
      const lowStockList = kitchenProducts.filter(p => p.stock <= p.lowStockThreshold);

      return (
        <div className="space-y-4 animate-fade-up">
          <div className="flex flex-col tablet:flex-row tablet:items-center justify-between gap-3">
            <div>
              <span className="text-[10px] font-extrabold uppercase tracking-[0.18em] text-brand-purple">Real-Time Catalog</span>
              <h1 className="font-editorial font-extrabold text-2xl tablet:text-3xl text-brand-ink mt-0.5">Menu &amp; Stock</h1>
            </div>
            {subTab === 'ITEMS' && canEditMenu && (
              <button
                type="button"
                onClick={openNewItem}
                className="h-11 px-4 rounded-full bg-brand-purple hover:bg-brand-deep text-white font-editorial font-extrabold text-xs shadow-pill flex items-center gap-1.5 self-start btn-tactile"
              >
                <Icon name="plus" className="w-4 h-4 text-brand-yellow" />
                <span>Add Food Item</span>
              </button>
            )}
          </div>

          <div className="grid grid-cols-3 gap-1.5 p-1 bg-white rounded-full border border-brand-hairline max-w-md">
            <button
              type="button"
              onClick={() => setSubTab('ITEMS')}
              className={`py-2 text-xs font-extrabold rounded-full transition ${subTab === 'ITEMS' ? 'bg-brand-purple text-white shadow-pill' : 'text-brand-muted'}`}
            >
              Items ({kitchenProducts.length})
            </button>
            <button
              type="button"
              onClick={() => setSubTab('CATEGORIES')}
              className={`py-2 text-xs font-extrabold rounded-full transition ${subTab === 'CATEGORIES' ? 'bg-brand-purple text-white shadow-pill' : 'text-brand-muted'}`}
            >
              Categories ({kitchenCategories.length})
            </button>
            <button
              type="button"
              onClick={() => setSubTab('STOCK')}
              className={`py-2 text-xs font-extrabold rounded-full transition flex items-center justify-center gap-1 ${subTab === 'STOCK' ? 'bg-brand-purple text-white shadow-pill' : 'text-brand-muted'}`}
            >
              <span>Stock</span>
              {lowStockList.length > 0 && (
                <span className="px-1.5 py-0.2 rounded-full bg-brand-orange text-white text-[10px]">{lowStockList.length}</span>
              )}
            </button>
          </div>

          {subTab === 'ITEMS' && (
            <div className="space-y-4">
              <div className="relative">
                <span className="absolute left-3.5 top-3 text-brand-purple">
                  <Icon name="search" className="w-4 h-4" />
                </span>
                <input
                  type="text"
                  value={search}
                  onChange={(e) => setSearch(e.target.value)}
                  placeholder="Search menu items..."
                  className="w-full h-10 pl-10 pr-4 rounded-full bg-white border border-brand-hairline text-xs"
                />
              </div>

              <div className="grid grid-cols-1 tablet:grid-cols-2 gap-4">
                {filteredProducts.map(prod => (
                  <article key={prod.id} className="bg-white rounded-[24px] p-4 border border-brand-hairline shadow-editorial flex flex-col justify-between gap-3">
                    <div className="flex items-start gap-3.5">
                      <img src={prod.image} onerror={`this.src='${FALLBACK_FOOD_IMG}'`} alt={prod.name} className="w-20 h-20 rounded-2xl object-cover shrink-0 bg-brand-canvas" />
                      <div className="min-w-0 flex-1">
                        <div className="flex items-start justify-between gap-2">
                          <div>
                            <div className="flex items-center gap-1.5 flex-wrap">
                              <h3 className="font-editorial font-extrabold text-sm tablet:text-base text-brand-ink">{prod.name}</h3>
                              {prod.isPopular && (
                                <span className="px-2 py-0.5 rounded-full bg-brand-yellow text-brand-ink text-[9px] font-extrabold uppercase">POPULAR</span>
                              )}
                            </div>
                            <div className="text-[11px] text-brand-muted mt-0.5">
                              {prod.categoryName} • Prep {prod.prepTime}m • Stock: <strong className={prod.stock <= prod.lowStockThreshold ? 'text-brand-orange' : 'text-brand-ink'}>{prod.stock}</strong>
                            </div>
                          </div>
                          <span className="font-editorial font-extrabold text-base text-brand-purple">{formatCurrency(prod.price)}</span>
                        </div>
                        <p className="text-xs text-brand-muted line-clamp-2 mt-1">{prod.description}</p>
                      </div>
                    </div>

                    <div className="pt-3 border-t border-brand-canvas flex items-center justify-between gap-2">
                      <label className="inline-flex items-center gap-2 cursor-pointer">
                        <input
                          type="checkbox"
                          checked={prod.available}
                          onChange={() => handleToggleAvailability(prod)}
                          className="sr-only peer"
                        />
                        <div className="w-9 h-5 bg-brand-hairline rounded-full peer peer-checked:after:translate-x-4 after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:bg-white after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-brand-purple relative" />
                        <span className={`text-xs font-extrabold ${prod.available ? 'text-brand-purple' : 'text-brand-orange'}`}>
                          {prod.available ? 'Available' : 'Unavailable'}
                        </span>
                      </label>

                      {canEditMenu && (
                        <div className="flex items-center gap-2">
                          <button
                            type="button"
                            onClick={() => openEditItem(prod)}
                            className="h-8 px-3 rounded-full bg-brand-canvas hover:bg-brand-hairline text-brand-ink font-extrabold text-xs btn-tactile"
                          >
                            Edit
                          </button>
                          <button
                            type="button"
                            onClick={async () => {
                              try {
                                await Backend.deleteMenuProduct(sessionToken, prod.id);
                                showToast(`Removed ${prod.name}`);
                                onRefresh();
                              } catch (err) {
                                showToast(err.message, 'error');
                              }
                            }}
                            className="h-8 px-3 rounded-full text-brand-orange hover:bg-brand-orange/10 font-extrabold text-xs"
                          >
                            Archive
                          </button>
                        </div>
                      )}
                    </div>
                  </article>
                ))}
              </div>
            </div>
          )}

          {subTab === 'CATEGORIES' && (
            <div className="bg-white rounded-[26px] p-5 border border-brand-hairline shadow-editorial space-y-4">
              {canEditMenu && (
                <form onSubmit={handleAddCategory} className="flex gap-2">
                  <input
                    type="text"
                    value={newCatName}
                    onChange={(e) => setNewCatName(e.target.value)}
                    placeholder="New category name (e.g. Festive Combos)"
                    className="flex-1 h-10 px-4 rounded-full bg-brand-canvas border border-brand-hairline text-xs font-semibold"
                  />
                  <button type="submit" className="h-10 px-5 rounded-full bg-brand-purple text-white font-editorial font-extrabold text-xs shadow-pill btn-tactile">
                    Create
                  </button>
                </form>
              )}

              <div className="divide-y divide-brand-canvas">
                {kitchenCategories.map((cat, idx) => {
                  const count = kitchenProducts.filter(p => p.categoryId === cat.id).length;
                  return (
                    <div key={cat.id} className="py-3 flex items-center justify-between gap-3">
                      <div className="flex items-center gap-3">
                        <div className="flex flex-col">
                          <button
                            type="button"
                            onClick={async () => {
                              if (idx === 0) return;
                              const prev = kitchenCategories[idx - 1];
                              await DB.put('categories', { ...cat, sortOrder: prev.sortOrder });
                              await DB.put('categories', { ...prev, sortOrder: cat.sortOrder });
                              onRefresh();
                            }}
                            className="text-[10px] text-brand-muted hover:text-brand-ink"
                          >▲</button>
                          <button
                            type="button"
                            onClick={async () => {
                              if (idx === kitchenCategories.length - 1) return;
                              const next = kitchenCategories[idx + 1];
                              await DB.put('categories', { ...cat, sortOrder: next.sortOrder });
                              await DB.put('categories', { ...next, sortOrder: cat.sortOrder });
                              onRefresh();
                            }}
                            className="text-[10px] text-brand-muted hover:text-brand-ink"
                          >▼</button>
                        </div>

                        {renamingId === cat.id ? (
                          <div className="flex items-center gap-2">
                            <input
                              type="text"
                              value={renamingVal}
                              onChange={(e) => setRenamingVal(e.target.value)}
                              className="h-8 px-2.5 rounded-xl border border-brand-hairline text-xs font-bold"
                            />
                            <button
                              type="button"
                              onClick={async () => {
                                await DB.put('categories', { ...cat, name: renamingVal.trim() || cat.name });
                                setRenamingId(null);
                                onRefresh();
                              }}
                              className="text-xs font-extrabold text-brand-purple"
                            >Save</button>
                          </div>
                        ) : (
                          <div>
                            <div className="font-editorial font-extrabold text-sm text-brand-ink">{cat.name}</div>
                            <div className="text-[11px] text-brand-muted">{count} linked item(s)</div>
                          </div>
                        )}
                      </div>

                      <div className="flex items-center gap-1.5">
                        <button
                          type="button"
                          onClick={async () => {
                            await DB.put('categories', { ...cat, enabled: !cat.enabled });
                            onRefresh();
                          }}
                          className={`h-8 px-2.5 rounded-full text-[11px] font-extrabold ${cat.enabled ? 'bg-brand-purple/10 text-brand-purple' : 'bg-brand-canvas text-brand-muted'}`}
                        >
                          {cat.enabled ? 'Active' : 'Disabled'}
                        </button>
                        <button
                          type="button"
                          onClick={() => { setRenamingId(cat.id); setRenamingVal(cat.name); }}
                          className="h-8 px-2.5 rounded-full bg-brand-canvas text-brand-ink text-[11px] font-bold"
                        >
                          Rename
                        </button>
                        <button
                          type="button"
                          onClick={() => handleSafeDeleteCategory(cat)}
                          className="h-8 px-2.5 rounded-full text-brand-orange hover:bg-brand-orange/10 text-[11px] font-bold"
                        >
                          Delete
                        </button>
                      </div>
                    </div>
                  );
                })}
              </div>
            </div>
          )}

          {subTab === 'STOCK' && (
            <div className="space-y-4">
              {lowStockList.length > 0 && (
                <div className="p-4 rounded-2xl bg-brand-orange/10 border border-brand-orange/30 flex items-center gap-2.5 text-xs text-brand-ink">
                  <Icon name="alert" className="w-5 h-5 text-brand-orange shrink-0" />
                  <div>
                    <strong className="font-extrabold">{lowStockList.length} Low/Out-of-Stock Alert:</strong>{' '}
                    {lowStockList.map(p => `${p.name} (${p.stock} left)`).join(', ')}
                  </div>
                </div>
              )}

              <div className="bg-white rounded-[26px] border border-brand-hairline shadow-editorial divide-y divide-brand-canvas">
                {kitchenProducts.map(prod => (
                  <div key={prod.id} className="p-4 flex items-center justify-between gap-3">
                    <div>
                      <div className="font-editorial font-extrabold text-sm text-brand-ink">{prod.name}</div>
                      <div className="text-xs text-brand-muted">
                        Alert below {prod.lowStockThreshold} •{' '}
                        <strong className={prod.stock === 0 ? 'text-brand-orange' : prod.stock <= prod.lowStockThreshold ? 'text-brand-orange' : 'text-emerald-600'}>
                          {prod.stock === 0 ? 'Out of Stock' : prod.stock <= prod.lowStockThreshold ? 'Low Stock' : 'In Stock'}
                        </strong>
                      </div>
                    </div>
                    <div className="flex items-center gap-2">
                      <button
                        type="button"
                        disabled={!canManageStock}
                        onClick={async () => {
                          try {
                            await Backend.adjustProductStock(sessionToken, prod.id, -1, 'DELTA', 'Manual Reduction');
                            onRefresh();
                          } catch (err) {
                            showToast(err.message, 'error');
                          }
                        }}
                        className="w-8 h-8 rounded-full bg-brand-canvas font-extrabold text-brand-ink disabled:opacity-40"
                      >−1</button>
                      <span className="w-9 text-center font-editorial font-extrabold text-base text-brand-ink">{prod.stock}</span>
                      <button
                        type="button"
                        disabled={!canManageStock}
                        onClick={async () => {
                          try {
                            await Backend.adjustProductStock(sessionToken, prod.id, +5, 'DELTA', 'Quick Restock (+5)');
                            onRefresh();
                          } catch (err) {
                            showToast(err.message, 'error');
                          }
                        }}
                        className="h-8 px-3 rounded-full bg-brand-purple text-white font-editorial font-extrabold text-xs shadow-pill btn-tactile disabled:opacity-40"
                      >+5</button>
                    </div>
                  </div>
                ))}
              </div>

              <div className="bg-white rounded-[26px] p-5 border border-brand-hairline shadow-editorial">
                <h3 className="font-editorial font-extrabold text-sm text-brand-ink mb-3">Stock Adjustment Audit Logs</h3>
                <div className="space-y-2 max-h-60 overflow-y-auto">
                  {kitchenLogs.slice(0, 15).map(log => (
                    <div key={log.id} className="flex items-center justify-between text-xs py-1.5 border-b border-brand-canvas">
                      <div>
                        <strong className="text-brand-ink">{log.productName}</strong> — <span className="text-brand-muted">{log.reason}</span>
                        <div className="text-[10px] text-brand-muted">{formatDateTime(log.timestamp)} • {log.actor}</div>
                      </div>
                      <div className="text-right">
                        <span className={`font-extrabold ${log.change >= 0 ? 'text-emerald-600' : 'text-brand-orange'}`}>
                          {log.change >= 0 ? `+${log.change}` : log.change}
                        </span>
                        <div className="text-[10px] text-brand-muted">Bal: {log.newStock}</div>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          )}

          {/* Add/Edit Item Modal */}
          <Modal
            open={modalOpen}
            onClose={() => setModalOpen(false)}
            title={editingProduct?.id ? 'Edit Menu Item' : 'Add New Menu Item'}
            subtitle="Price changes apply immediately to future orders; historical snapshots remain locked."
          >
            {editingProduct && (
              <form onSubmit={handleSaveProduct} className="space-y-3.5">
                <div>
                  <label className="block text-[11px] font-bold uppercase text-brand-muted mb-1">Dish Name</label>
                  <input
                    type="text"
                    required
                    value={editingProduct.name}
                    onChange={(e) => setEditingProduct({ ...editingProduct, name: e.target.value })}
                    className="w-full h-10 px-3.5 rounded-xl bg-brand-canvas border border-brand-hairline text-xs font-bold"
                  />
                </div>
                <div>
                  <label className="block text-[11px] font-bold uppercase text-brand-muted mb-1">Description</label>
                  <textarea
                    rows="2"
                    value={editingProduct.description}
                    onChange={(e) => setEditingProduct({ ...editingProduct, description: e.target.value })}
                    className="w-full p-3 rounded-xl bg-brand-canvas border border-brand-hairline text-xs"
                  />
                </div>
                <div className="grid grid-cols-2 gap-3">
                  <div>
                    <label className="block text-[11px] font-bold uppercase text-brand-muted mb-1">Category</label>
                    <select
                      value={editingProduct.categoryId}
                      onChange={(e) => setEditingProduct({ ...editingProduct, categoryId: e.target.value })}
                      className="w-full h-10 px-3 rounded-xl bg-brand-canvas border border-brand-hairline text-xs font-bold"
                    >
                      {kitchenCategories.map(c => <option key={c.id} value={c.id}>{c.name}</option>)}
                    </select>
                  </div>
                  <div>
                    <label className="block text-[11px] font-bold uppercase text-brand-muted mb-1">Image URL</label>
                    <input
                      type="url"
                      value={editingProduct.image}
                      onChange={(e) => setEditingProduct({ ...editingProduct, image: e.target.value })}
                      className="w-full h-10 px-3 rounded-xl bg-brand-canvas border border-brand-hairline text-xs"
                    />
                  </div>
                </div>
                <div className="grid grid-cols-3 gap-2.5">
                  <div>
                    <label className="block text-[11px] font-bold uppercase text-brand-muted mb-1">Price (₹)</label>
                    <input
                      type="number"
                      min="1"
                      required
                      disabled={!canChangePrices && !!editingProduct.id}
                      value={editingProduct.price}
                      onChange={(e) => setEditingProduct({ ...editingProduct, price: e.target.value })}
                      className="w-full h-10 px-3 rounded-xl bg-brand-canvas border border-brand-hairline text-xs font-extrabold disabled:opacity-50"
                    />
                  </div>
                  <div>
                    <label className="block text-[11px] font-bold uppercase text-brand-muted mb-1">Prep (m)</label>
                    <input
                      type="number"
                      min="2"
                      required
                      value={editingProduct.prepTime}
                      onChange={(e) => setEditingProduct({ ...editingProduct, prepTime: e.target.value })}
                      className="w-full h-10 px-3 rounded-xl bg-brand-canvas border border-brand-hairline text-xs font-bold"
                    />
                  </div>
                  <div>
                    <label className="block text-[11px] font-bold uppercase text-brand-muted mb-1">Stock</label>
                    <input
                      type="number"
                      min="0"
                      required
                      value={editingProduct.stock}
                      onChange={(e) => setEditingProduct({ ...editingProduct, stock: e.target.value })}
                      className="w-full h-10 px-3 rounded-xl bg-brand-canvas border border-brand-hairline text-xs font-bold"
                    />
                  </div>
                </div>
                <label className="flex items-center gap-2 text-xs font-bold text-brand-ink cursor-pointer">
                  <input
                    type="checkbox"
                    checked={editingProduct.isPopular}
                    onChange={(e) => setEditingProduct({ ...editingProduct, isPopular: e.target.checked })}
                    className="w-4 h-4 accent-brand-purple"
                  />
                  <span>Mark as Popular / Hot Item</span>
                </label>
                <button
                  type="submit"
                  className="w-full h-12 rounded-2xl bg-brand-purple text-white font-editorial font-extrabold text-sm shadow-pill btn-tactile"
                >
                  Save Menu Item
                </button>
              </form>
            )}
          </Modal>
        </div>
      );
    };

    /**
     * =========================================================================
     * 15. COMPLETE ORDER HISTORY SCREEN (HIDES NET SETTLEMENT FOR STAFF)
     * =========================================================================
     */
    const OrderHistoryScreen = ({ orders, currentUser, onInspectOrder }) => {
      const [rangeFilter, setRangeFilter] = useState('ALL');
      const [statusFilter, setStatusFilter] = useState('ALL');
      const [search, setSearch] = useState('');
      const [startDate, setStartDate] = useState('');
      const [endDate, setEndDate] = useState('');
      const isOwner = currentUser?.role === 'OWNER';
      const filtered = useMemo(() => {
        const now = new Date();
        const startToday = new Date(now.getFullYear(), now.getMonth(), now.getDate()).getTime();
        const dayMs = 86400000;

        return orders.filter(o => {
          if (rangeFilter === 'TODAY' && o.createdAt < startToday) return false;
          if (rangeFilter === 'YESTERDAY' && (o.createdAt < startToday - dayMs || o.createdAt >= startToday)) return false;
          if (rangeFilter === '7D' && o.createdAt < now.getTime() - 7 * dayMs) return false;
          if (rangeFilter === '30D' && o.createdAt < now.getTime() - 30 * dayMs) return false;
          if (rangeFilter === 'CUSTOM') {
            if (startDate && o.createdAt < new Date(startDate).getTime()) return false;
            if (endDate && o.createdAt > new Date(endDate).getTime() + dayMs) return false;
          }

          if (statusFilter !== 'ALL') {
            if (statusFilter === 'CANCELLED_ALL') {
              if (!['CANCELLED', 'REJECTED', 'REFUNDED'].includes(o.status)) return false;
            } else if (o.status !== statusFilter) {
              return false;
            }
          }

          if (search.trim()) {
            const q = search.toLowerCase();
            const mId = o.id.toLowerCase().includes(q);
            const mCust = o.customerName.toLowerCase().includes(q);
            const mProd = o.items.some(i => i.name.toLowerCase().includes(q));
            if (!mId && !mCust && !mProd) return false;
          }
          return true;
        });
      }, [orders, rangeFilter, statusFilter, search, startDate, endDate]);

      return (
        <div className="space-y-4 animate-fade-up">
          <div>
            <span className="text-[10px] font-extrabold uppercase tracking-[0.18em] text-brand-purple">Permanent Archive</span>
            <h1 className="font-editorial font-extrabold text-2xl tablet:text-3xl text-brand-ink mt-0.5">Order History</h1>
          </div>

          <div className="flex items-center gap-1.5 overflow-x-auto no-scrollbar pb-1">
            {[
              { id: 'ALL', label: 'All Time' },
              { id: 'TODAY', label: 'Today' },
              { id: 'YESTERDAY', label: 'Yesterday' },
              { id: '7D', label: 'Last 7 Days' },
              { id: '30D', label: 'Last 30 Days' },
              { id: 'CUSTOM', label: 'Custom Range' }
            ].map(p => (
              <button
                key={p.id}
                type="button"
                onClick={() => setRangeFilter(p.id)}
                className={`h-9 px-3.5 rounded-full text-xs font-extrabold whitespace-nowrap transition btn-tactile ${
                  rangeFilter === p.id ? 'bg-brand-purple text-white shadow-pill' : 'bg-white border border-brand-hairline text-brand-ink'
                }`}
              >
                {p.label}
              </button>
            ))}
          </div>

          {rangeFilter === 'CUSTOM' && (
            <div className="grid grid-cols-2 gap-2.5 bg-white p-3.5 rounded-2xl border border-brand-hairline">
              <div>
                <label className="block text-[10px] font-bold uppercase text-brand-muted mb-1">From</label>
                <input type="date" value={startDate} onChange={e => setStartDate(e.target.value)} className="w-full h-9 px-2.5 rounded-xl bg-brand-canvas border border-brand-hairline text-xs" />
              </div>
              <div>
                <label className="block text-[10px] font-bold uppercase text-brand-muted mb-1">To</label>
                <input type="date" value={endDate} onChange={e => setEndDate(e.target.value)} className="w-full h-9 px-2.5 rounded-xl bg-brand-canvas border border-brand-hairline text-xs" />
              </div>
            </div>
          )}

          <div className="flex flex-col tablet:flex-row gap-2.5">
            <div className="relative flex-1">
              <span className="absolute left-3.5 top-3 text-brand-purple">
                <Icon name="search" className="w-4 h-4" />
              </span>
              <input
                type="text"
                value={search}
                onChange={(e) => setSearch(e.target.value)}
                placeholder="Search Order ID, Customer Name, or Dish..."
                className="w-full h-10 pl-10 pr-4 rounded-full bg-white border border-brand-hairline text-xs"
              />
            </div>
            <select
              value={statusFilter}
              onChange={(e) => setStatusFilter(e.target.value)}
              className="h-10 px-4 rounded-full bg-white border border-brand-hairline text-xs font-extrabold"
            >
              <option value="ALL">All Statuses</option>
              <option value="COMPLETED">Completed</option>
              <option value="CANCELLED_ALL">Cancelled / Rejected / Refunded</option>
            </select>
          </div>

          <div className="bg-white rounded-[26px] border border-brand-hairline shadow-editorial divide-y divide-brand-canvas overflow-hidden">
            {filtered.length === 0 ? (
              <div className="p-10 text-center text-xs text-brand-muted">No matching historical orders found.</div>
            ) : (
              filtered.map(order => {
                const isVoid = ['CANCELLED', 'REJECTED', 'REFUNDED'].includes(order.status);
                return (
                  <div
                    key={order.id}
                    onClick={() => onInspectOrder(order)}
                    className="p-4 hover:bg-brand-canvas/60 cursor-pointer transition flex flex-col tablet:flex-row tablet:items-center justify-between gap-2.5"
                  >
                    <div className="space-y-1">
                      <div className="flex items-center gap-2 flex-wrap">
                        <span className="font-editorial font-extrabold text-sm text-brand-ink">#{order.id}</span>
                        <StatusBadge status={order.status} />
                        <span className="text-[11px] text-brand-muted">{formatDateTime(order.createdAt)} • {order.paymentMethod}</span>
                      </div>
                      <div className="text-xs font-semibold text-brand-ink">
                        {order.customerName} • <span className="text-brand-muted font-normal">{order.items.map(i => `${i.qty}× ${i.name}`).join(', ')}</span>
                      </div>
                    </div>
                    <div className="flex tablet:flex-col items-center tablet:items-end justify-between gap-1 shrink-0">
                      <span className="font-editorial font-extrabold text-sm text-brand-ink">Subtotal: {formatCurrency(order.foodSubtotal)}</span>
                      {isOwner && (
                        <span className={`text-xs font-extrabold ${isVoid ? 'text-brand-orange' : 'text-brand-purple'}`}>
                          {isVoid ? 'Void / Refunded' : `Net Settlement: ${formatCurrency(order.restaurantSettlement)}`}
                        </span>
                      )}
                    </div>
                  </div>
                );
              })
            )}
          </div>
        </div>
      );
    };

    /**
     * =========================================================================
     * 16. OWNER-ONLY PIN-PROTECTED FINANCIAL & SETTLEMENT DASHBOARD
     * Authoritative Order & Snapshot Aggregation (Zero Hardcoded Values)
     * =========================================================================
     */
    const FinancialDashboardScreen = ({ sessionToken, currentUser, activeRestaurantId, isPinUnlocked, onUnlockPin, showToast }) => {
      const [pinDigits, setPinDigits] = useState('');
      const [pinError, setPinError] = useState('');
      const [verifying, setVerifying] = useState(false);

      const [loadingData, setLoadingData] = useState(false);
      const [fetchError, setFetchError] = useState('');
      const [reconciling, setReconciling] = useState(false);
      const [finPayload, setFinPayload] = useState({
        restaurantId: activeRestaurantId,
        fetchedAt: null,
        records: [],
        missingSnapshotOrderIds: [],
        settlements: [],
        settlementTransactions: []
      });

      const [chartPeriod, setChartPeriod] = useState('DAILY');
      const [subTab, setSubTab] = useState('OVERVIEW'); // 'OVERVIEW' | 'SETTLEMENTS'
      const [dateFrom, setDateFrom] = useState('');
      const [dateTo, setDateTo] = useState('');

      // Strict Owner-only check
      if (currentUser?.role !== 'OWNER') {
        return (
          <div className="bg-white rounded-[28px] p-8 border border-brand-orange/30 text-center max-w-md mx-auto mt-6 shadow-editorial">
            <div className="w-12 h-12 rounded-2xl bg-brand-orange/10 text-brand-orange flex items-center justify-center mx-auto mb-3">
              <Icon name="shield" className="w-6 h-6" />
            </div>
            <h2 className="font-editorial font-extrabold text-lg text-brand-ink">403 Forbidden — Owner-Only Access</h2>
            <p className="text-xs text-brand-muted mt-1.5">
              Your staff role (<strong className="text-brand-ink">{currentUser?.roleLabel}</strong>) does not have access to financial earnings, commissions, or bank settlements.
            </p>
          </div>
        );
      }

      const fetchFinancialData = useCallback(async () => {
        if (!isPinUnlocked || !sessionToken || !activeRestaurantId) return;
        setLoadingData(true);
        setFetchError('');
        try {
          const response = await Backend.getFinancialDashboardData(sessionToken, activeRestaurantId);
          if (response.restaurantId !== activeRestaurantId) {
            throw new Error(`Restaurant ID mismatch: expected ${activeRestaurantId}, received ${response.restaurantId}`);
          }
          setFinPayload(response);
        } catch (err) {
          setFetchError(err.message || 'Failed to load financial records from database.');
        } finally {
          setLoadingData(false);
        }
      }, [isPinUnlocked, sessionToken, activeRestaurantId]);

      useEffect(() => {
        fetchFinancialData();
      }, [fetchFinancialData]);

      // Auto-refresh when a completed order or settlement event arrives on RealtimeBus
      useEffect(() => {
        if (!isPinUnlocked) return;
        const unsubOrder = RealtimeBus.subscribe('ORDER_UPDATED', (ord) => {
          if (ord?.restaurantId === activeRestaurantId) {
            fetchFinancialData();
          }
        });
        const unsubSettlement = RealtimeBus.subscribe('SETTLEMENT_UPDATED', () => {
          fetchFinancialData();
        });
        return () => {
          unsubOrder();
          unsubSettlement();
        };
      }, [isPinUnlocked, activeRestaurantId, fetchFinancialData]);

      const handleReconcileSnapshots = async () => {
        setReconciling(true);
        try {
          const { reconciledCount } = await Backend.reconcileMissingSnapshots(sessionToken, activeRestaurantId);
          triggerHaptic();
          if (showToast) {
            showToast(`Reconciled ${reconciledCount} historical financial snapshot(s)`);
          }
          await fetchFinancialData();
        } catch (err) {
          setFetchError(err.message);
        } finally {
          setReconciling(false);
        }
      };

      const handleUnlock = async (e) => {
        e.preventDefault();
        setPinError('');
        setVerifying(true);
        try {
          await Backend.verifyOwnerPin(sessionToken, pinDigits, activeRestaurantId);
          triggerHaptic();
          onUnlockPin();
        } catch (err) {
          triggerHaptic();
          setPinError(err.message);
          setPinDigits('');
        } finally {
          setVerifying(false);
        }
      };

      if (!isPinUnlocked) {
        return (
          <div className="max-w-md mx-auto mt-6 animate-fade-up">
            <div className="bg-white rounded-[28px] p-6 tablet:p-8 border border-brand-hairline shadow-editorial text-center space-y-4">
              <div className="w-14 h-14 rounded-2xl bg-brand-purple text-brand-yellow flex items-center justify-center mx-auto shadow-pill">
                <Icon name="lock" className="w-7 h-7" />
              </div>
              <div>
                <h2 className="font-editorial font-extrabold text-xl text-brand-ink">Owner 6-Digit Security PIN</h2>
                <p className="text-xs text-brand-muted mt-1">
                  Enter your 6-digit PIN to decrypt food sales, commissions &amp; settlement payouts.
                </p>
              </div>

              {pinError && (
                <div className="p-3 rounded-2xl bg-brand-orange/10 border border-brand-orange/30 text-brand-orange text-xs font-bold">
                  {pinError}
                </div>
              )}

              <form onSubmit={handleUnlock} className="space-y-4">
                <input
                  type="password"
                  inputMode="numeric"
                  maxLength={6}
                  required
                  autoFocus
                  value={pinDigits}
                  onChange={(e) => setPinDigits(e.target.value.replace(/\D/g, ''))}
                  placeholder="••••••"
                  className="w-full h-14 px-4 rounded-2xl bg-brand-canvas border border-brand-hairline focus:border-brand-purple focus:bg-white focus:outline-none text-center font-editorial font-extrabold text-2xl tracking-[0.5em]"
                />
                <button
                  type="submit"
                  disabled={verifying || pinDigits.length !== 6}
                  className="w-full h-12 rounded-2xl bg-brand-purple hover:bg-brand-deep text-white font-editorial font-extrabold text-sm shadow-pill btn-tactile disabled:opacity-50"
                >
                  {verifying ? 'Verifying Salted SHA-256 Hash...' : 'Unlock Financial Dashboard'}
                </button>
              </form>

              <p className="text-[11px] text-brand-muted">
                Salted SHA-256 PIN verification • 5-attempt lockout (5 mins)
              </p>
            </div>
          </div>
        );
      }

      // Apply selected date range filter across deduplicated records
      const scopedRecords = useMemo(() => {
        const dayMs = 86400000;
        const fromTs = dateFrom ? new Date(`${dateFrom}T00:00:00`).getTime() : null;
        const toTs = dateTo ? new Date(`${dateTo}T00:00:00`).getTime() + dayMs - 1 : null;
        const seen = new Set();

        return (finPayload.records || []).filter(rec => {
          const ord = rec.order;
          if (!ord || seen.has(ord.id)) return false;
          seen.add(ord.id);
          if (fromTs !== null && ord.createdAt < fromTs) return false;
          if (toTs !== null && ord.createdAt > toTs) return false;
          return true;
        });
      }, [finPayload.records, dateFrom, dateTo]);

      // Separate Completed vs Active vs Cancelled vs Refunded orders strictly
      const completedRecords = scopedRecords.filter(r => r.order.status === 'COMPLETED');
      const activeRecords = scopedRecords.filter(r => ['NEW', 'ACCEPTED', 'PREPARING', 'READY', 'ON_THE_WAY'].includes(r.order.status));
      const cancelledRecords = scopedRecords.filter(r => ['CANCELLED', 'REJECTED'].includes(r.order.status));
      const refundedRecords = scopedRecords.filter(r => r.order.status === 'REFUNDED');

      const scopedMissingSnapshots = scopedRecords.filter(r => !r.snapshot);

      // Authoritative snapshot-based totals for COMPLETED orders only
      const completedTotals = useMemo(() => {
        let totalCompletedFoodSales = 0;
        let customerPlatformFees = 0;
        let restaurantCommission = 0;
        let restaurantNetSettlement = 0;
        let pendingPayout = 0;
        let paidPayout = 0;

        for (const rec of completedRecords) {
          const snap = rec.snapshot;
          if (!snap) continue; // Do not silently fabricate zero when snapshot is missing
          totalCompletedFoodSales += Number(snap.foodSubtotal || 0);
          customerPlatformFees += Number(snap.customerPlatformFee || 0);
          restaurantCommission += Number(snap.restaurantCommission || 0);
          restaurantNetSettlement += Number(snap.restaurantSettlement || 0);

          const payoutStatus = snap.payoutStatus || rec.order.payoutStatus || 'PENDING';
          if (payoutStatus === 'PAID') {
            paidPayout += Number(snap.restaurantSettlement || 0);
          } else if (payoutStatus !== 'VOID') {
            pendingPayout += Number(snap.restaurantSettlement || 0);
          }
        }

        return {
          totalCompletedFoodSales: Math.round(totalCompletedFoodSales * 100) / 100,
          customerPlatformFees: Math.round(customerPlatformFees * 100) / 100,
          restaurantCommission: Math.round(restaurantCommission * 100) / 100,
          restaurantNetSettlement: Math.round(restaurantNetSettlement * 100) / 100,
          pendingPayout: Math.round(pendingPayout * 100) / 100,
          paidPayout: Math.round(paidPayout * 100) / 100
        };
      }, [completedRecords]);

      // Active / Unsettled Order Value calculated separately (never mixed with completed sales)
      const activeUnsettledStats = useMemo(() => {
        let grossFoodValue = 0;
        let estimatedNetSettlement = 0;
        for (const rec of activeRecords) {
          const src = rec.snapshot || rec.order;
          grossFoodValue += Number(src.foodSubtotal || 0);
          estimatedNetSettlement += Number(src.restaurantSettlement || 0);
        }
        return {
          grossFoodValue: Math.round(grossFoodValue * 100) / 100,
          estimatedNetSettlement: Math.round(estimatedNetSettlement * 100) / 100
        };
      }, [activeRecords]);

      // 100% Real Database-Computed Charts (Daily, Weekly, Monthly) — Zero Hardcoded Values
      const chartBars = useMemo(() => {
        const completedWithSnap = completedRecords.filter(r => !!r.snapshot);
        const anchorTs = dateTo ? new Date(`${dateTo}T00:00:00`).getTime() : Date.now();
        const anchorDate = new Date(anchorTs);
        const dayMs = 86400000;

        if (chartPeriod === 'DAILY') {
          const arr = [];
          for (let i = 6; i >= 0; i--) {
            const d = new Date(anchorDate.getFullYear(), anchorDate.getMonth(), anchorDate.getDate() - i);
            const start = d.getTime();
            const end = start + dayMs;
            const label = d.toLocaleDateString('en-IN', { day: '2-digit', month: 'short' });
            const bucket = completedWithSnap.filter(r => r.order.createdAt >= start && r.order.createdAt < end);
            arr.push({
              label,
              sales: Math.round(bucket.reduce((s, r) => s + Number(r.snapshot.foodSubtotal || 0), 0) * 100) / 100,
              net: Math.round(bucket.reduce((s, r) => s + Number(r.snapshot.restaurantSettlement || 0), 0) * 100) / 100,
              count: bucket.length
            });
          }
          return arr;
        }

        if (chartPeriod === 'WEEKLY') {
          const arr = [];
          const anchorDayStart = new Date(anchorDate.getFullYear(), anchorDate.getMonth(), anchorDate.getDate()).getTime();
          for (let w = 5; w >= 0; w--) {
            const weekEnd = anchorDayStart + dayMs - w * 7 * dayMs;
            const weekStart = weekEnd - 7 * dayMs;
            const startLbl = new Date(weekStart).toLocaleDateString('en-IN', { day: '2-digit', month: 'short' });
            const bucket = completedWithSnap.filter(r => r.order.createdAt >= weekStart && r.order.createdAt < weekEnd);
            arr.push({
              label: w === 0 ? 'This Wk' : startLbl,
              sales: Math.round(bucket.reduce((s, r) => s + Number(r.snapshot.foodSubtotal || 0), 0) * 100) / 100,
              net: Math.round(bucket.reduce((s, r) => s + Number(r.snapshot.restaurantSettlement || 0), 0) * 100) / 100,
              count: bucket.length
            });
          }
          return arr;
        }

        // MONTHLY (Last 6 calendar months up to anchorDate)
        const arr = [];
        for (let m = 5; m >= 0; m--) {
          const mStartObj = new Date(anchorDate.getFullYear(), anchorDate.getMonth() - m, 1);
          const mEndObj = new Date(anchorDate.getFullYear(), anchorDate.getMonth() - m + 1, 1);
          const start = mStartObj.getTime();
          const end = mEndObj.getTime();
          const label = mStartObj.toLocaleDateString('en-IN', { month: 'short', year: '2-digit' });
          const bucket = completedWithSnap.filter(r => r.order.createdAt >= start && r.order.createdAt < end);
          arr.push({
            label,
            sales: Math.round(bucket.reduce((s, r) => s + Number(r.snapshot.foodSubtotal || 0), 0) * 100) / 100,
            net: Math.round(bucket.reduce((s, r) => s + Number(r.snapshot.restaurantSettlement || 0), 0) * 100) / 100,
            count: bucket.length
          });
        }
        return arr;
      }, [chartPeriod, completedRecords, dateTo]);

      const maxVal = Math.max(1, ...chartBars.map(b => b.sales));
      const hasAnyChartSales = chartBars.some(b => b.sales > 0);

      // Derive live settlement ledger records directly from actual restaurant settlements & completed snapshots
      const liveSettlementRecords = useMemo(() => {
        const storedSettlements = finPayload.settlements || [];
        const completedSnaps = completedRecords.filter(r => !!r.snapshot);
        const unsettledCompleted = completedSnaps.filter(r => (r.snapshot.payoutStatus || r.order.payoutStatus) !== 'PAID');
        const paidCompleted = completedSnaps.filter(r => (r.snapshot.payoutStatus || r.order.payoutStatus) === 'PAID');

        const derived = [];

        if (unsettledCompleted.length > 0) {
          derived.push({
            id: `SET-${activeRestaurantId.toUpperCase()}-PENDING`,
            periodLabel: `Current Unsettled Cycle (${unsettledCompleted.length} completed order${unsettledCompleted.length === 1 ? '' : 's'})`,
            eligibleSales: Math.round(unsettledCompleted.reduce((s, r) => s + Number(r.snapshot.foodSubtotal || 0), 0) * 100) / 100,
            commissionDeducted: Math.round(unsettledCompleted.reduce((s, r) => s + Number(r.snapshot.restaurantCommission || 0), 0) * 100) / 100,
            netPayout: Math.round(unsettledCompleted.reduce((s, r) => s + Number(r.snapshot.restaurantSettlement || 0), 0) * 100) / 100,
            status: 'PENDING',
            utrReference: 'Awaiting Scheduled NEFT Disbursement',
            settlementDate: Date.now()
          });
        }

        if (paidCompleted.length > 0) {
          const matchedBatch = storedSettlements.find(s => s.status === 'PAID');
          derived.push({
            id: matchedBatch?.id || `SET-${activeRestaurantId.toUpperCase()}-PAID`,
            periodLabel: matchedBatch?.periodLabel || `Settled Payouts (${paidCompleted.length} completed order${paidCompleted.length === 1 ? '' : 's'})`,
            eligibleSales: Math.round(paidCompleted.reduce((s, r) => s + Number(r.snapshot.foodSubtotal || 0), 0) * 100) / 100,
            commissionDeducted: Math.round(paidCompleted.reduce((s, r) => s + Number(r.snapshot.restaurantCommission || 0), 0) * 100) / 100,
            netPayout: Math.round(paidCompleted.reduce((s, r) => s + Number(r.snapshot.restaurantSettlement || 0), 0) * 100) / 100,
            status: 'PAID',
            utrReference: matchedBatch?.utrReference || 'Verified NEFT Settlement',
            settlementDate: matchedBatch?.settlementDate || paidCompleted[0].order.completedAt || paidCompleted[0].order.createdAt
          });
        }

        return derived;
      }, [finPayload.settlements, completedRecords, activeRestaurantId]);

      const exportCsvReport = () => {
        const headers = [
          'Order ID', 'Restaurant ID', 'Date', 'Status', 'Snapshot Present',
          'Food Subtotal (INR)', 'Customer Platform Fee (INR)', 'Customer Paid (INR)',
          'Restaurant Commission (INR)', 'Restaurant Net Settlement (INR)', 'Payout Status'
        ];
        const rows = scopedRecords.map(({ order: o, snapshot: s }) => [
          o.id,
          o.restaurantId,
          new Date(o.createdAt).toISOString(),
          o.status,
          s ? 'YES' : 'MISSING',
          s ? s.foodSubtotal : o.foodSubtotal,
          s ? s.customerPlatformFee : 0,
          s ? s.customerPayable : 0,
          s ? s.restaurantCommission : 0,
          o.status === 'COMPLETED' && s ? s.restaurantSettlement : 0,
          s ? (s.payoutStatus || 'VOID') : 'MISSING_SNAPSHOT'
        ]);
        const csv = [headers.join(','), ...rows.map(r => r.join(','))].join('\n');
        const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `Zatpatgo_${activeRestaurantId}_Financials_${new Date().toISOString().slice(0, 10)}.csv`;
        a.click();
        triggerHaptic();
      };

      return (
        <div className="space-y-5 animate-fade-up">
          <div className="flex flex-col tablet:flex-row tablet:items-center justify-between gap-3">
            <div>
              <div className="flex items-center gap-2 flex-wrap">
                <h1 className="font-editorial font-extrabold text-2xl tablet:text-3xl text-brand-ink">Financials &amp; Settlements</h1>
