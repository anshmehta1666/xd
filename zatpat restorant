    /**
     * =========================================================================
     * 9. LIVE INCOMING & ACTIVE ORDER CARD COMPONENT (GRANULAR RBAC AWARE)
     * =========================================================================
     */
    const OrderCard = ({ order, currentUser, timeoutSeconds = 90, onAction, onInspect }) => {
      const [elapsedSec, setElapsedSec] = useState(Math.floor((Date.now() - order.createdAt) / 1000));
      const perms = currentUser?.permissions || {};
      const canAccept = currentUser?.role === 'OWNER' || perms.acceptOrders;
      const canKitchen = currentUser?.role === 'OWNER' || perms.updateKitchenStatus;
      const canManage = currentUser?.role === 'OWNER' || perms.manageOrders;

      useEffect(() => {
        if (order.status !== 'NEW') return;
        const timer = setInterval(() => {
          setElapsedSec(Math.floor((Date.now() - order.createdAt) / 1000));
        }, 1000);
        return () => clearInterval(timer);
      }, [order.status, order.createdAt]);

      const remainingSec = Math.max(0, timeoutSeconds - elapsedSec);
      const progressPct = Math.min(100, Math.round((remainingSec / timeoutSeconds) * 100));

      return (
        <article
          className={`card-tactile bg-white rounded-[24px] border transition-all shadow-editorial overflow-hidden ${
            order.status === 'NEW'
              ? 'border-brand-orange ring-2 ring-brand-orange/20'
              : 'border-brand-hairline hover:border-brand-purple/40'
          }`}
        >
          {/* Countdown Strip for Manual Acceptance */}
          {order.status === 'NEW' && (
            <div className="bg-brand-orange/10 px-4 py-2 border-b border-brand-orange/20 flex items-center justify-between gap-2">
              <div className="flex items-center gap-2 text-xs font-extrabold text-brand-orange">
                <span className="w-2 h-2 rounded-full bg-brand-orange animate-ping" />
                <span>Action Required • {remainingSec}s remaining</span>
              </div>
              <div className="w-24 h-1.5 bg-brand-orange/20 rounded-full overflow-hidden">
                <div className="h-full bg-brand-orange transition-all duration-1000" style={{ width: `${progressPct}%` }} />
              </div>
            </div>
          )}

          <div className="p-4 tablet:p-5">
            <div className="flex items-start justify-between gap-2">
              <div>
                <div className="flex items-center gap-2 flex-wrap">
                  <span className="font-editorial font-extrabold text-base text-brand-ink">#{order.id}</span>
                  <StatusBadge status={order.status} />
                  {order.autoAccepted && (
                    <span className="text-[10px] font-extrabold px-2.5 py-0.5 rounded-full bg-brand-purple/10 text-brand-purple">
                      AUTO-ACCEPTED
                    </span>
                  )}
                </div>
                <div className="text-xs text-brand-muted mt-1 flex items-center gap-1.5 flex-wrap">
                  <strong className="text-brand-ink">{order.customerName}</strong>
                  <span>•</span>
                  <span>{formatTime(order.createdAt)}</span>
                  <span>•</span>
                  <span className="font-semibold">{order.deliveryType}</span>
                </div>
              </div>

              <button
                type="button"
                onClick={() => onInspect(order)}
                className="text-xs font-extrabold text-brand-purple hover:underline px-2.5 py-1 rounded-full bg-brand-canvas shrink-0"
              >
                Details →
              </button>
            </div>

            {/* Itemized List */}
            <div className="mt-3 pt-3 border-t border-brand-canvas space-y-1.5">
              {order.items.map((item, idx) => (
                <div key={idx} className="flex items-start justify-between text-xs tablet:text-sm">
                  <div className="flex items-start gap-2">
                    <span className="px-2 py-0.5 rounded-lg bg-brand-purple/10 text-brand-purple font-editorial font-extrabold text-xs">
                      {item.qty}×
                    </span>
                    <div>
                      <div className="font-bold text-brand-ink leading-snug">{item.name}</div>
                      {(item.variant || item.addons?.length > 0) && (
                        <div className="text-[11px] text-brand-muted">
                          {item.variant}{item.addons?.length ? ` • +${item.addons.join(', ')}` : ''}
                        </div>
                      )}
                    </div>
                  </div>
                  <span className="font-editorial font-extrabold text-brand-ink text-xs">{formatCurrency(item.unitPrice * item.qty)}</span>
                </div>
              ))}
            </div>

            {order.specialInstructions && (
              <div className="mt-3 px-3.5 py-2 rounded-2xl bg-brand-yellow/25 border border-brand-yellow text-xs text-brand-ink">
                <strong className="font-extrabold">Cooking Note:</strong> {order.specialInstructions}
              </div>
            )}

            {/* Assigned Delivery Partner */}
            {order.deliveryPartner && ['READY', 'ON_THE_WAY'].includes(order.status) && (
              <div className="mt-3 p-3 rounded-2xl bg-brand-canvas border border-brand-hairline flex items-center justify-between gap-2.5">
                <div className="flex items-center gap-2.5 min-w-0">
                  <div className="w-9 h-9 rounded-xl bg-brand-purple text-white flex items-center justify-center shrink-0">
                    <Icon name="bike" className="w-4 h-4" />
                  </div>
                  <div className="min-w-0">
                    <div className="text-xs font-extrabold text-brand-ink truncate">{order.deliveryPartner.name}</div>
                    <div className="text-[11px] text-brand-muted truncate">{order.deliveryPartner.vehicle}</div>
                  </div>
                </div>
                <a
                  href={`tel:${order.deliveryPartner.phone}`}
                  className="w-9 h-9 rounded-full bg-white text-brand-purple border border-brand-hairline flex items-center justify-center shrink-0 btn-tactile"
                  title="Call Delivery Partner"
                >
                  <Icon name="phone" className="w-4 h-4" />
                </a>
              </div>
            )}

            {/* Financial & Prep Footer */}
            <div className="mt-3 pt-3 border-t border-brand-canvas flex items-center justify-between text-xs">
              <div className="flex items-center gap-2">
                <span className="font-editorial font-extrabold text-base text-brand-ink">{formatCurrency(order.foodSubtotal)}</span>
                <span className="px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 font-extrabold text-[10px]">
                  {order.paymentStatus}
                </span>
              </div>
              <span className="font-bold text-brand-muted">Prep: {order.prepTimeMinutes} mins</span>
            </div>

            {/* Stage Action Buttons (Strictly gated by User Permissions) */}
            <div className="mt-3.5 space-y-2">
              {order.status === 'NEW' && (
                canAccept ? (
                  <div className="grid grid-cols-3 gap-2">
                    <button
                      type="button"
                      onClick={() => onAction(order, 'REJECT_MODAL')}
                      className="col-span-1 h-11 rounded-2xl border border-brand-orange/30 bg-brand-orange/10 hover:bg-brand-orange/20 text-brand-orange font-editorial font-extrabold text-xs btn-tactile"
                    >
                      Reject
                    </button>
                    <button
                      type="button"
                      onClick={() => onAction(order, 'ACCEPTED')}
                      className="col-span-2 h-11 rounded-2xl bg-brand-purple hover:bg-brand-deep text-white font-editorial font-extrabold text-xs shadow-pill flex items-center justify-center gap-1.5 btn-tactile"
                    >
                      <Icon name="check" className="w-4 h-4 text-brand-yellow" />
                      <span>Accept Order ({order.prepTimeMinutes}m)</span>
                    </button>
                  </div>
                ) : (
                  <div className="p-2.5 rounded-xl bg-brand-canvas text-[11px] font-bold text-brand-muted text-center">
                    View-only: Order acceptance permission not assigned
                  </div>
                )
              )}

              {order.status === 'ACCEPTED' && canKitchen && (
                <button
                  type="button"
                  onClick={() => onAction(order, 'PREPARING')}
                  className="w-full h-11 rounded-2xl bg-brand-orange hover:opacity-95 text-white font-editorial font-extrabold text-xs shadow-orange-glow btn-tactile"
                >
                  Start Preparing Order
                </button>
              )}

              {order.status === 'PREPARING' && canKitchen && (
                <button
                  type="button"
                  onClick={() => onAction(order, 'READY')}
                  className="w-full h-11 rounded-2xl bg-brand-purple hover:bg-brand-deep text-white font-editorial font-extrabold text-xs shadow-pill flex items-center justify-center gap-1.5 btn-tactile"
                >
                  <Icon name="check" className="w-4 h-4 text-brand-yellow" />
                  <span>Mark Ready</span>
                </button>
              )}

              {order.status === 'READY' && canManage && (
                <div className="space-y-2">
                  {order.deliveryType === 'DELIVERY' && !order.deliveryPartner && (
                    <button
                      type="button"
                      onClick={() => onAction(order, 'ASSIGN_RIDER')}
                      className="w-full h-10 rounded-2xl bg-brand-yellow text-brand-ink font-editorial font-extrabold text-xs btn-tactile"
                    >
                      Request &amp; Assign Delivery Partner
                    </button>
                  )}
                  <button
                    type="button"
                    onClick={() => onAction(order, order.deliveryType === 'PICKUP' ? 'COMPLETED' : 'ON_THE_WAY')}
                    className="w-full h-11 rounded-2xl bg-brand-deep hover:bg-brand-purple text-white font-editorial font-extrabold text-xs shadow-pill flex items-center justify-center gap-1.5 btn-tactile"
                  >
                    <Icon name="bike" className="w-4 h-4 text-brand-yellow" />
                    <span>{order.deliveryType === 'PICKUP' ? 'Confirm Customer Pickup' : 'Handover to Delivery Partner'}</span>
                  </button>
                </div>
              )}

              {order.status === 'ON_THE_WAY' && (
                <div className="grid grid-cols-2 gap-2">
                  <button
                    type="button"
                    onClick={() => onInspect(order)}
                    className="h-11 rounded-2xl bg-brand-canvas hover:bg-brand-hairline text-brand-ink font-editorial font-extrabold text-xs btn-tactile"
                  >
                    Delivery Status
                  </button>
                  {canManage && (
                    <button
                      type="button"
                      onClick={() => onAction(order, 'COMPLETED')}
                      className="h-11 rounded-2xl bg-brand-purple hover:bg-brand-deep text-white font-editorial font-extrabold text-xs shadow-pill btn-tactile"
                    >
                      Confirm Delivered
                    </button>
                  )}
                </div>
              )}
            </div>
          </div>
        </article>
      );
    };

    /**
     * =========================================================================
     * 10. ORDER DETAIL & IMMUTABLE SNAPSHOT MODAL (HIDES SETTLEMENT FOR STAFF)
     * =========================================================================
     */
    const OrderDetailModal = ({ order, currentUser, onClose, onUpdatePrepTime }) => {
      const [prepInput, setPrepInput] = useState(order?.prepTimeMinutes || 18);
      const isOwner = currentUser?.role === 'OWNER';

      useEffect(() => {
        if (order) setPrepInput(order.prepTimeMinutes);
      }, [order]);

      if (!order) return null;

      return (
        <Modal
          open={!!order}
          onClose={onClose}
          title={`Order #${order.id}`}
          subtitle={`${formatDateTime(order.createdAt)} • ${order.deliveryType}`}
          maxWidth="max-w-xl"
        >
          <div className="space-y-4">
            <div className="flex flex-wrap items-center justify-between gap-3 p-3.5 rounded-2xl bg-brand-canvas border border-brand-hairline">
              <div>
                <span className="text-[10px] font-extrabold uppercase tracking-wider text-brand-muted block">Status</span>
                <div className="mt-1"><StatusBadge status={order.status} /></div>
              </div>
              {['NEW', 'ACCEPTED', 'PREPARING'].includes(order.status) && (isOwner || currentUser?.permissions?.manageOrders) && (
                <div className="flex items-center gap-2">
                  <span className="text-xs font-bold text-brand-muted">Prep (m):</span>
                  <input
                    type="number"
                    min="5"
                    max="90"
                    value={prepInput}
                    onChange={(e) => setPrepInput(e.target.value)}
                    className="w-16 h-9 px-2 rounded-xl border border-brand-hairline bg-white text-xs font-extrabold text-center"
                  />
                  <button
                    type="button"
                    onClick={() => onUpdatePrepTime(order.id, prepInput)}
                    className="h-9 px-3 rounded-xl bg-brand-purple text-white text-xs font-extrabold btn-tactile"
                  >
                    Save
                  </button>
                </div>
              )}
            </div>

            <div className="grid grid-cols-1 tablet:grid-cols-2 gap-3 text-xs">
              <div className="p-3.5 rounded-2xl border border-brand-hairline">
                <div className="font-editorial font-extrabold text-brand-ink mb-1">Customer Details</div>
                <div className="font-bold text-brand-ink">{order.customerName}</div>
                <div className="text-brand-muted mt-0.5">{order.customerPhone}</div>
                <div className="text-brand-muted mt-1">{order.deliveryAddress}</div>
              </div>
              <div className="p-3.5 rounded-2xl border border-brand-hairline">
                <div className="font-editorial font-extrabold text-brand-ink mb-1">Delivery &amp; Payment</div>
                <div className="text-brand-ink">Payment: <strong>{order.paymentMethod}</strong></div>
                {order.deliveryPartner ? (
                  <div className="mt-1.5 text-brand-purple font-bold">
                    Partner: {order.deliveryPartner.name} ({order.deliveryPartner.phone})
                  </div>
                ) : (
                  <div className="mt-1.5 text-brand-muted">
                    {order.deliveryType === 'PICKUP' ? 'Customer Self-Pickup' : 'Partner assigned when order is Ready'}
                  </div>
                )}
              </div>
            </div>

            <div className="border border-brand-hairline rounded-2xl divide-y divide-brand-canvas">
              {order.items.map((item, i) => (
                <div key={i} className="p-3 flex justify-between items-center text-xs">
                  <div>
                    <div className="font-bold text-brand-ink">{item.qty} × {item.name}</div>
                    <div className="text-brand-muted">{item.variant}</div>
                  </div>
                  <div className="font-editorial font-extrabold text-brand-ink">{formatCurrency(item.unitPrice * item.qty)}</div>
                </div>
              ))}
            </div>

            {/* Immutable Financial Snapshot (Commission & Net Settlement visible ONLY to Owner) */}
            {isOwner ? (
              <div className="p-4 rounded-2xl bg-brand-deep text-white text-xs space-y-1.5">
                <div className="text-[10px] font-extrabold uppercase tracking-widest text-brand-yellow mb-1">
                  Immutable Financial Snapshot (Owner Only)
                </div>
                <div className="flex justify-between">
                  <span className="text-white/80">Food Subtotal (Locked Historical Price)</span>
                  <span className="font-bold">{formatCurrency(order.foodSubtotal)}</span>
                </div>
                <div className="flex justify-between">
                  <span className="text-white/80">Customer Platform Fee ({order.foodSubtotal < 100 ? 'Flat ₹15' : '5%'})</span>
                  <span>{formatCurrency(order.customerPlatformFee)}</span>
                </div>
