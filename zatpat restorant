    class ZatpatgoSharedApiGateway {
      constructor() {
        this.remoteAvailable = null;
        this.inFlightDedupe = new Map();
      }

      async request(endpoint, { method = 'GET', sessionToken = '', pinToken = '', body = null, idempotencyKey = '' } = {}) {
        const dedupeKey = `${method}:${endpoint}:${idempotencyKey || JSON.stringify(body || '')}`;
        if (method !== 'GET' && this.inFlightDedupe.has(dedupeKey)) {
          return this.inFlightDedupe.get(dedupeKey);
        }

        const exec = (async () => {
          const headers = {
            'Content-Type': 'application/json',
            'X-Zatpatgo-Zone': '385340'
          };
          if (sessionToken) headers['Authorization'] = `Bearer ${sessionToken}`;
          if (pinToken) headers['X-Owner-Pin-Token'] = pinToken;
          if (idempotencyKey) headers['X-Idempotency-Key'] = idempotencyKey;

          try {
            const controller = new AbortController();
            const timer = setTimeout(() => controller.abort(), 3500);
            const res = await fetch(`${SHARED_BACKEND_CONFIG.apiBaseUrl}${endpoint}`, {
              method,
              headers,
              body: body ? JSON.stringify(body) : undefined,
              signal: controller.signal
            });
            clearTimeout(timer);

            const contentType = res.headers.get('content-type') || '';
            if (!contentType.includes('application/json')) {
              this.remoteAvailable = false;
              return { remoteHandled: false };
            }

            const data = await res.json();
            this.remoteAvailable = true;
            if (!res.ok) {
              throw new Error(data.error || data.message || `API Error ${res.status}`);
            }
            return { remoteHandled: true, data };
          } catch (err) {
            if (err && err.name !== 'AbortError' && !String(err.message).includes('Failed to fetch') && !String(err.message).includes('NetworkError')) {
              throw err;
            }
            this.remoteAvailable = false;
            return { remoteHandled: false };
          } finally {
            this.inFlightDedupe.delete(dedupeKey);
          }
        })();

        if (method !== 'GET') this.inFlightDedupe.set(dedupeKey, exec);
        return exec;
      }

      broadcastStatusToCustomerApp(order) {
        try {
          if (window.parent && window.parent !== window) {
            window.parent.postMessage({
              namespace: SHARED_BACKEND_CONFIG.sharedNamespace,
              type: 'ZATPATGO_ORDER_STATUS_SYNC',
              payload: {
                orderId: order.id,
                restaurantId: order.restaurantId,
                status: order.status,
                prepTimeMinutes: order.prepTimeMinutes,
                deliveryPartner: order.deliveryPartner || null,
                updatedAt: Date.now()
              }
            }, SHARED_BACKEND_CONFIG.customerAppOrigin);
          }
          if (window.opener && !window.opener.closed) {
            window.opener.postMessage({
              namespace: SHARED_BACKEND_CONFIG.sharedNamespace,
              type: 'ZATPATGO_ORDER_STATUS_SYNC',
              payload: {
