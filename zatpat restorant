                    <div>
                      <strong className="text-brand-ink">Owner Account:</strong> Username <code className="text-brand-purple font-bold">visamo_owner</code> or Phone <code className="text-brand-purple font-bold">9875299621</code> (Pass: <code className="font-bold">visamo@385340</code>)
                    </div>
                    <div>
                      <strong className="text-brand-ink">Kitchen Manager:</strong> Username <code className="text-brand-purple font-bold">kitchen_ravi</code> or Phone <code className="text-brand-purple font-bold">9825011223</code> (Pass: <code className="font-bold">kitchen@385340</code>)
