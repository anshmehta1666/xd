      /**
       * ATOMIC INVENTORY HELPERS
       */
      async _deductStockForItems(restaurantId, items, orderId, reason, autoMarkUnavailable = true) {
        for (const item of items) {
          const prod = await DB.getById('products', item.productId);
          if (!prod) continue;
          prod.stock = Math.max(0, prod.stock - item.qty);
          if (prod.stock === 0 && autoMarkUnavailable) prod.available = false;
          await DB.put('products', prod);
          await DB.put('inventory', {
            id: CryptoUtils.generateId('INV'),
            restaurantId,
            productId: prod.id,
            productName: prod.name,
            change: -item.qty,
            newStock: prod.stock,
            reason: `${reason} (${orderId})`,
            actor: 'Inventory Engine',
            timestamp: Date.now()
          });

          if (prod.stock === 0) {
            await this.createNotification({
              restaurantId,
              title: `Out of Stock: ${prod.name}`,
              message: 'Stock reached 0 and item was automatically marked unavailable on customer menu.',
              category: 'STOCK',
              severity: 'ERROR'
            });
          } else if (prod.stock <= prod.lowStockThreshold) {
            await this.createNotification({
              restaurantId,
              title: `Low Stock Alert: ${prod.name}`,
              message: `Only ${prod.stock} units remaining (threshold: ${prod.lowStockThreshold}).`,
              category: 'STOCK',
              severity: 'WARNING'
            });
          }
        }
        RealtimeBus.publish('CATALOG_UPDATED', { restaurantId });
      }

      async _restoreStockForItems(restaurantId, items, orderId, reason) {
        for (const item of items) {
          const prod = await DB.getById('products', item.productId);
          if (!prod) continue;
          prod.stock = prod.stock + item.qty;
          if (prod.stock > 0) prod.available = true;
          await DB.put('products', prod);
          await DB.put('inventory', {
            id: CryptoUtils.generateId('INV'),
            restaurantId,
            productId: prod.id,
            productName: prod.name,
            change: item.qty,
            newStock: prod.stock,
            reason: `${reason} (${orderId})`,
            actor: 'Inventory Engine',
            timestamp: Date.now()
          });
        }
        RealtimeBus.publish('CATALOG_UPDATED', { restaurantId });
      }

      async adjustProductStock(sessionToken, productId, deltaOrSet, mode = 'DELTA', reason = 'Manual Stock Update') {
        const actor = await this.authorize(sessionToken, 'manageStock');
        const prod = await DB.getById('products', productId);
        if (!prod) throw new Error('Product not found.');
        const autoSettings = await DB.getById('orderAutomationSettings', `AUTO-${prod.restaurantId}`);
        const prev = prod.stock;
        const nextStock = mode === 'SET' ? Math.max(0, Number(deltaOrSet)) : Math.max(0, prev + Number(deltaOrSet));
        const actualDelta = nextStock - prev;
        prod.stock = nextStock;

        if (prod.stock === 0 && autoSettings?.autoMarkOutOfStockAtZero) {
          prod.available = false;
        } else if (prod.stock > 0 && actualDelta > 0) {
          prod.available = true;
        }

        await DB.put('products', prod);
        await DB.put('inventory', {
          id: CryptoUtils.generateId('INV'),
          restaurantId: prod.restaurantId,
          productId: prod.id,
          productName: prod.name,
          change: actualDelta,
          newStock: prod.stock,
          reason,
          actor: `${actor.name} (${actor.roleLabel})`,
          timestamp: Date.now()
        });
        await this.logAudit(actor.name, actor.role, 'STOCK_ADJUSTED', 'products', prod.id, `${prod.name}: ${actualDelta >= 0 ? '+' : ''}${actualDelta} -> ${prod.stock}`);
        RealtimeBus.publish('CATALOG_UPDATED', { restaurantId: prod.restaurantId });
        return prod;
      }

      async saveMenuProduct(sessionToken, productPayload) {
        const isNew = !productPayload.id;
        const actor = await this.authorize(sessionToken, 'editMenu');
        if (!isNew) {
          const existing = await DB.getById('products', productPayload.id);
          if (existing && Number(existing.price) !== Number(productPayload.price)) {
            await this.authorize(sessionToken, 'changePrices');
          }
        }
        await DB.put('products', productPayload);
        await this.logAudit(actor.name, actor.role, isNew ? 'PRODUCT_CREATED' : 'PRODUCT_UPDATED', 'products', productPayload.id, `${productPayload.name} (${formatCurrency(productPayload.price)})`);
        RealtimeBus.publish('CATALOG_UPDATED', { restaurantId: productPayload.restaurantId });
        return productPayload;
      }

      async deleteMenuProduct(sessionToken, productId) {
        const actor = await this.authorize(sessionToken, 'editMenu');
        const prod = await DB.getById('products', productId);
        await DB.delete('products', productId);
        await this.logAudit(actor.name, actor.role, 'PRODUCT_ARCHIVED', 'products', productId, prod?.name || productId);
        RealtimeBus.publish('CATALOG_UPDATED', { restaurantId: prod?.restaurantId });
      }

      async updateRestaurantStatus(sessionToken, restaurantId, { isOnline, offlineReason = '', pauseMinutes = null }) {
        const actor = await this.authorize(sessionToken, 'manageSettings', true);
        const settings = await DB.getById('restaurantSettings', `SET-${restaurantId}`);
        settings.isOnline = isOnline;
        settings.offlineReason = isOnline ? '' : (offlineReason || 'Temporarily offline');
        settings.pausedUntil = (!isOnline && pauseMinutes) ? Date.now() + Number(pauseMinutes) * 60000 : null;
        await DB.put('restaurantSettings', settings);
        await this.logAudit(actor.name, actor.role, isOnline ? 'RESTAURANT_ONLINE' : 'RESTAURANT_OFFLINE', 'restaurantSettings', settings.id, settings.offlineReason);
        if (!isOnline) {
          await this.createNotification({
            restaurantId,
            title: 'Kitchen Marked Offline',
            message: pauseMinutes ? `Paused for ${pauseMinutes} mins (${settings.offlineReason}).` : `Offline: ${settings.offlineReason}`,
            category: 'SYSTEM',
            severity: 'WARNING'
          });
        }
        RealtimeBus.publish('SETTINGS_UPDATED', settings);
        return settings;
      }

      async updateBusyMode(sessionToken, restaurantId, busyConfig) {
        const actor = await this.authorize(sessionToken, 'manageSettings', true);
        const settings = await DB.getById('restaurantSettings', `SET-${restaurantId}`);
        const expiresAt = (busyConfig.enabled && busyConfig.durationMinutes)
          ? Date.now() + Number(busyConfig.durationMinutes) * 60000
          : null;
        settings.busyMode = {
          ...settings.busyMode,
          ...busyConfig,
          expiresAt
        };
        await DB.put('restaurantSettings', settings);
        await this.logAudit(actor.name, actor.role, busyConfig.enabled ? 'BUSY_MODE_ON' : 'BUSY_MODE_OFF', 'restaurantSettings', settings.id, JSON.stringify(settings.busyMode));
        RealtimeBus.publish('SETTINGS_UPDATED', settings);
        return settings;
      }

      async saveAutomationSettings(sessionToken, restaurantId, newAuto) {
        const actor = await this.authorize(sessionToken, 'manageSettings', true);
        const existing = await DB.getById('orderAutomationSettings', `AUTO-${restaurantId}`);
        const merged = { ...existing, ...newAuto };
        await DB.put('orderAutomationSettings', merged);
        await this.logAudit(actor.name, actor.role, 'AUTOMATION_UPDATED', 'orderAutomationSettings', merged.id, `AutoAccept: ${merged.autoAcceptEnabled}`);
        RealtimeBus.publish('AUTOMATION_UPDATED', merged);
        return merged;
      }
