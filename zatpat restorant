  <script>
    (function setupZatpatgoPartnerPWA() {
      function generatePngIconDataUrl(size) {
        const canvas = document.createElement('canvas');
        canvas.width = size;
        canvas.height = size;
        const ctx = canvas.getContext('2d');
        if (!ctx) return '';

        const radius = size * 0.235;
        ctx.fillStyle = '#5426C8';
        ctx.beginPath();
        ctx.moveTo(radius, 0);
        ctx.lineTo(size - radius, 0);
        ctx.quadraticCurveTo(size, 0, size, radius);
        ctx.lineTo(size, size - radius);
        ctx.quadraticCurveTo(size, size, size - radius, size);
        ctx.lineTo(radius, size);
        ctx.quadraticCurveTo(0, size, 0, size - radius);
        ctx.lineTo(0, radius);
        ctx.quadraticCurveTo(0, 0, radius, 0);
        ctx.closePath();
        ctx.fill();

        ctx.strokeStyle = '#FFFFFF';
        ctx.lineWidth = size * 0.09;
        ctx.lineCap = 'round';
        ctx.lineJoin = 'round';
        ctx.beginPath();
        ctx.moveTo(size * 0.25, size * 0.305);
        ctx.lineTo(size * 0.75, size * 0.305);
        ctx.lineTo(size * 0.38, size * 0.695);
        ctx.lineTo(size * 0.75, size * 0.695);
        ctx.stroke();

        ctx.fillStyle = '#FFD84D';
        ctx.beginPath();
        ctx.arc(size * 0.75, size * 0.305, size * 0.068, 0, Math.PI * 2);
        ctx.fill();

        return canvas.toDataURL('image/png');
      }

      try {
        const icon192 = generatePngIconDataUrl(192);
        const icon512 = generatePngIconDataUrl(512);
        const appleIconEl = document.getElementById('pwa-apple-icon');
        if (appleIconEl && icon192) appleIconEl.href = icon192;

        const manifest = {
          name: 'Zatpatgo Partner — Radhanpur 385340',
          short_name: 'Zatpatgo Partner',
          description: 'Restaurant Partner Command Center for Zatpatgo in Radhanpur 385340.',
          start_url: './',
          display: 'standalone',
