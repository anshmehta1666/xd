    };

    /**
     * =========================================================================
     * 18. MAIN APPLICATION SHELL (SINGLE LOGIN + ROLE-BASED NAVIGATION)
     * =========================================================================
     */
    const App = () => {
      const [booting, setBooting] = useState(true);
      const [sessionToken, setSessionToken] = useState(() => sessionStorage.getItem('ztg_partner_tok') || localStorage.getItem('ztg_partner_tok') || '');
      const [currentUser, setCurrentUser] = useState(null);
      const [activeRestaurantId, setActiveRestaurantId] = useState('visamo');
      const [activeNav, setActiveNav] = useState('HOME');
      const [isPinUnlocked, setIsPinUnlocked] = useState(false);

      // IndexedDB State
      const [restaurants, setRestaurants] = useState([]);
      const [settings, setSettings] = useState(null);
      const [operatingHours, setOperatingHours] = useState(null);
      const [autoSettings, setAutoSettings] = useState(null);
      const [products, setProducts] = useState([]);
      const [categories, setCategories] = useState([]);
      const [orders, setOrders] = useState([]);
      const [inventoryLogs, setInventoryLogs] = useState([]);
      const [notifications, setNotifications] = useState([]);
      const [staffList, setStaffList] = useState([]);
      const [auditLogs, setAuditLogs] = useState([]);

      // Modals
      const [simulatorOpen, setSimulatorOpen] = useState(false);
      const [automationModalOpen, setAutomationModalOpen] = useState(false);
      const [notifDrawerOpen, setNotifDrawerOpen] = useState(false);
      const [inspectedOrder, setInspectedOrder] = useState(null);
      const [rejectTargetOrder, setRejectTargetOrder] = useState(null);
      const [rejectReason, setRejectReason] = useState('Item currently out of stock');
      const [toast, setToast] = useState(null);
      const [installPromptEvent, setInstallPromptEvent] = useState(null);

      const showToast = useCallback((message, type = 'success') => {
        setToast({ message, type, id: Date.now() });
        setTimeout(() => {
          setToast(prev => (prev && Date.now() - prev.id >= 3000 ? null : prev));
        }, 3200);
      }, []);

      const loadAllState = useCallback(async (targetRestId = activeRestaurantId) => {
        await Backend.bootstrap();
        if (sessionToken && targetRestId) {
          await Backend.pullOrdersFromCentralBackend(sessionToken, targetRestId);
        }
        const [
          rests, sets, hrs, autoSets, prods, cats, ords, invs, notifs, staffs, audits
        ] = await Promise.all([
          DB.getAll('restaurants'),
          DB.getById('restaurantSettings', `SET-${targetRestId}`),
          DB.getById('restaurantOperatingHours', `HRS-${targetRestId}`),
          DB.getById('orderAutomationSettings', `AUTO-${targetRestId}`),
          DB.getAll('products'),
          DB.getAll('categories'),
          DB.getAll('orders'),
          DB.getAll('inventory'),
          DB.getAll('notifications'),
          DB.getAll('restaurantStaff'),
          DB.getAll('auditLogs')
        ]);

        setRestaurants(rests);
        setSettings(sets);
        setOperatingHours(hrs);
        setAutoSettings(autoSets);
        setProducts(prods);
        setCategories(cats);
        setOrders(ords.filter(o => o.restaurantId === targetRestId).sort((a, b) => b.createdAt - a.createdAt));
        setInventoryLogs(invs);
        setNotifications(notifs.filter(n => n.restaurantId === targetRestId).sort((a, b) => b.createdAt - a.createdAt));
        setStaffList(staffs);
        setAuditLogs(audits.sort((a, b) => b.timestamp - a.timestamp));
      }, [activeRestaurantId]);

      useEffect(() => {
        loadAllState(activeRestaurantId).then(async () => {
          if (sessionToken) {
            const validUser = await Backend.getSessionUser(sessionToken);
            if (validUser) {
              setCurrentUser(validUser);
              setActiveRestaurantId(validUser.restaurantId || 'visamo');
              await loadAllState(validUser.restaurantId || 'visamo');
            } else {
              localStorage.removeItem('ztg_partner_tok');
              sessionStorage.removeItem('ztg_partner_tok');
              setSessionToken('');
            }
          }
          setBooting(false);
        });

        const unsub = RealtimeBus.subscribe('*', (ev) => {
          loadAllState(activeRestaurantId);
          if (ev.type === 'NOTIFICATION_CREATED' && ev.payload?.category === 'ORDER') {
            SoundEngine.playOrderChime();
            triggerHaptic();
          }
        });

        // Cross-origin Customer PWA -> Restaurant Partner PWA live order bridge
        const onWindowMessage = async (event) => {
          const msg = event?.data;
          if (!msg || msg.namespace !== SHARED_BACKEND_CONFIG.sharedNamespace) return;
          if (msg.type === 'ZATPATGO_NEW_CUSTOMER_ORDER' && msg.payload) {
            try {
              const { order, duplicate } = await Backend.ingestAuthoritativeCustomerOrder(msg.payload);
              if (!duplicate && order.restaurantId === activeRestaurantId) {
                SoundEngine.playOrderChime();
                triggerHaptic();
                showToast(`New Customer Order #${order.id} synced!`);
              }
              await loadAllState(activeRestaurantId);
            } catch (err) {
              showToast(err.message, 'error');
            }
          }
        };
        window.addEventListener('message', onWindowMessage);

        // Periodic central backend order polling (every 12s while authenticated)
        const syncInterval = setInterval(() => {
          if (sessionToken) {
            loadAllState(activeRestaurantId);
          }
        }, 12000);

        const onBeforeInstall = (e) => {
          e.preventDefault();
          setInstallPromptEvent(e);
        };
        window.addEventListener('beforeinstallprompt', onBeforeInstall);

        return () => {
          unsub();
          window.removeEventListener('message', onWindowMessage);
          clearInterval(syncInterval);
          window.removeEventListener('beforeinstallprompt', onBeforeInstall);
        };
      }, [activeRestaurantId, loadAllState, sessionToken, showToast]);

      const handleAuthenticated = async ({ sessionToken: newTok, user }) => {
        setSessionToken(newTok);
        setCurrentUser(user);
        setIsPinUnlocked(false);
        const targetKitchen = user.restaurantId || 'visamo';
        setActiveRestaurantId(targetKitchen);
        localStorage.setItem('ztg_partner_tok', newTok);
        sessionStorage.setItem('ztg_partner_tok', newTok);
        await loadAllState(targetKitchen);
        showToast(`Signed in as ${user.name} (${user.roleLabel})`);
      };

      const handleLogout = async () => {
        triggerHaptic();
        await Backend.logout(sessionToken);
        localStorage.removeItem('ztg_partner_tok');
        sessionStorage.removeItem('ztg_partner_tok');
        setSessionToken('');
