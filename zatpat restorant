                    <div>
                      <label className="block text-[11px] font-bold uppercase tracking-wider text-brand-muted mb-1.5">
                        New Password (Min 6 chars)
                      </label>
                      <input
                        type="password"
                        required
                        minLength={6}
                        value={newResetPassword}
                        onChange={(e) => setNewResetPassword(e.target.value)}
                        placeholder="Enter new password"
                        className="w-full h-12 px-4 rounded-2xl bg-brand-canvas border border-brand-hairline focus:border-brand-purple focus:bg-white focus:outline-none text-sm font-semibold text-brand-ink"
                      />
                    </div>
                  </>
                )}

                {mode !== 'FORGOT' && (
                  <label className="flex items-center gap-2 text-xs font-semibold text-brand-muted cursor-pointer select-none">
                    <input
                      type="checkbox"
                      checked={rememberMe}
                      onChange={(e) => setRememberMe(e.target.checked)}
                      className="w-4 h-4 rounded accent-brand-purple"
                    />
                    <span>Keep session signed in on this device</span>
                  </label>
                )}

                <button
                  type="submit"
                  disabled={loading}
                  className="w-full h-12 rounded-2xl bg-brand-purple hover:bg-brand-deep text-white font-editorial font-extrabold text-sm tracking-wide shadow-pill transition btn-tactile disabled:opacity-60"
                >
                  {loading
                    ? 'Authenticating...'
                    : mode === 'FORGOT'
                      ? (otpSent ? 'Update Password' : 'Send Recovery OTP')
                      : (mode === 'OTP' && !otpSent)
                        ? 'Send Verification OTP'
                        : 'Login'}
                </button>

                {mode === 'FORGOT' && (
                  <button
                    type="button"
                    onClick={() => { setMode('PASSWORD'); setOtpSent(false); setError(''); setInfoMsg(''); }}
