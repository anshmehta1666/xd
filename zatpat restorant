      /**
       * SINGLE UNIFIED AUTHENTICATION & SESSION MANAGEMENT
       * Identifies account role & permissions automatically from backend DB
       */
      async login({ identifier, password, mode = 'PASSWORD', otp = '', rememberMe = true }) {
        const users = await DB.getAll('users');
        const clean = identifier.trim().toLowerCase().replace(/^\+91/, '').replace(/\s+/g, '');
        const user = users.find(u =>
          u.username.toLowerCase() === clean ||
          (u.email && u.email.toLowerCase() === clean) ||
          u.phone === clean
        );

        if (!user) {
          throw new Error('Account not found for this username or +91 mobile number.');
        }
        if (!user.active) {
          throw new Error('This account has been deactivated. Contact your Restaurant Owner.');
        }

        if (mode === 'OTP') {
          if (!/^\d{6}$/.test(otp)) {
            throw new Error('Enter the 6-digit verification OTP sent to your registered +91 mobile.');
          }
        } else {
          if (!user.passwordHash) {
            throw new Error('This staff account uses OTP-only login. Switch to Mobile OTP above.');
          }
          const hash = await this.hashWithSalt(user.passwordSalt, password);
          if (hash !== user.passwordHash) {
            await this.logAudit(user.name, user.role, 'FAILED_LOGIN', 'users', user.id, 'Invalid password attempt');
            throw new Error('Invalid password. Verify your credentials or use Forgot Password.');
          }
        }

        const sessionToken = CryptoUtils.generateId('SES');
        const ttl = rememberMe ? 7 * 86400000 : 12 * 3600000;
        const sessionRecord = {
          id: sessionToken,
          userId: user.id,
          restaurantId: user.restaurantId,
          role: user.role,
          createdAt: Date.now(),
          expiresAt: Date.now() + ttl
        };
        await DB.put('sessions', sessionRecord);
        await this.logAudit(user.name, user.role, 'UNIFIED_LOGIN', 'users', user.id, `Signed in via ${mode}`);

        return {
          sessionToken,
          user: this._sanitizeUser(user)
        };
      }

      async getSessionUser(sessionToken) {
        if (!sessionToken) return null;
        try {
          const user = await this.authorize(sessionToken);
          return this._sanitizeUser(user);
        } catch (_) {
          return null;
        }
      }

      async logout(sessionToken) {
        if (!sessionToken) return;
        const session = await DB.getById('sessions', sessionToken);
        if (session) {
          const user = await DB.getById('users', session.userId);
          if (user) {
            await this.logAudit(user.name, user.role, 'LOGOUT', 'users', user.id, 'Session terminated');
          }
          await DB.delete('sessions', sessionToken);
        }
      }

      async resetPasswordWithOtp({ identifier, otp, newPassword }) {
        if (!/^\d{6}$/.test(otp)) {
          throw new Error('Please enter the 6-digit recovery OTP.');
        }
        if (!newPassword || newPassword.length < 6) {
          throw new Error('New password must be at least 6 characters.');
        }
        const users = await DB.getAll('users');
        const clean = identifier.trim().toLowerCase().replace(/^\+91/, '').replace(/\s+/g, '');
        const user = users.find(u =>
          u.active && (
            u.username.toLowerCase() === clean ||
            (u.email && u.email.toLowerCase() === clean) ||
            u.phone === clean
          )
        );
        if (!user) throw new Error('No active account found for this username or phone.');

        const newSalt = CryptoUtils.generateId('SALT');
        user.passwordSalt = newSalt;
        user.passwordHash = await this.hashWithSalt(newSalt, newPassword);
        await DB.put('users', user);
        await DB.put('restaurantStaff', user);
        await this.logAudit(user.name, user.role, 'PASSWORD_RESET', 'users', user.id, 'Password updated via recovery OTP');
        return true;
      }

      _sanitizeUser(user) {
        const isOwner = user.role === 'OWNER';
        return {
          id: user.id,
          restaurantId: user.restaurantId,
          username: user.username,
          name: user.name,
          role: user.role,
          roleLabel: user.roleLabel || (isOwner ? 'Restaurant Owner' : 'Kitchen Manager'),
          phone: user.phone,
          email: user.email,
          active: user.active,
          permissions: isOwner
            ? { ...OWNER_FULL_PERMISSIONS }
            : { ...DEFAULT_STAFF_PERMISSIONS, ...(user.permissions || {}), accessFinancials: false, manageStaff: false, manageSettings: false }
        };
      }

      /**
       * OWNER 6-DIGIT PIN PROTECTION & 5-ATTEMPT / 5-MINUTE LOCKOUT
       */
      async verifyOwnerPin(sessionToken, pinInput, activeRestaurantId) {
        const user = await this.authorize(sessionToken, 'accessFinancials', true);
        const targetRestId = activeRestaurantId || user.restaurantId;

        // Forward to remote central backend API when available
        const remote = await SharedApi.request('/owner/verify-pin', {
          method: 'POST',
          sessionToken,
          body: { restaurantId: targetRestId, pin: pinInput }
        });
        if (remote.remoteHandled) {
          this.pinSecurity.verifiedSessions.set(`${sessionToken}::${targetRestId}`, {
            expiresAt: Date.now() + 30 * 60000,
            pinToken: remote.data.pinToken || sessionToken
          });
          return true;
        }

        const now = Date.now();
        if (this.pinSecurity.lockedUntil > now) {
          const secs = Math.ceil((this.pinSecurity.lockedUntil - now) / 1000);
          const mins = Math.floor(secs / 60);
          const remS = secs % 60;
          throw new Error(`Security Lockout: Too many failed PIN attempts. Try again in ${mins}m ${remS}s.`);
        }

        const restaurant = await DB.getById('restaurants', targetRestId);
        const inputHash = await this.hashWithSalt(restaurant.pinSalt || 'ZTG-PIN-SALT-385340', pinInput);

        if (inputHash !== restaurant.ownerPinHash) {
          this.pinSecurity.failedAttempts += 1;
          if (this.pinSecurity.failedAttempts >= 5) {
            this.pinSecurity.lockedUntil = now + 300000; // 5-minute rate-limit lockout
            this.pinSecurity.failedAttempts = 0;
            await this.logAudit(user.name, user.role, 'PIN_LOCKOUT_5M', 'restaurants', restaurant.id, '5 failed PIN attempts triggered 5-min lockout');
            throw new Error('Security Lockout: 5 incorrect PIN attempts. Financial access locked for 5 minutes.');
          }
          const left = 5 - this.pinSecurity.failedAttempts;
          throw new Error(`Incorrect 6-digit Owner PIN. ${left} attempt(s) remaining before 5-minute lockout.`);
        }

        const pinSessionToken = CryptoUtils.generateId('PINTOK');
        this.pinSecurity.failedAttempts = 0;
        this.pinSecurity.lockedUntil = 0;
        this.pinSecurity.verifiedSessions.set(`${sessionToken}::${targetRestId}`, {
          expiresAt: now + 30 * 60000,
          pinToken: pinSessionToken
        });
        await this.logAudit(user.name, user.role, 'FINANCIAL_PIN_VERIFIED', 'restaurants', restaurant.id, 'Unlocked Owner Financial Dashboard');
        return true;
      }

      isPinSessionVerified(sessionToken, restaurantId) {
        const key = `${sessionToken}::${restaurantId}`;
        const entry = this.pinSecurity.verifiedSessions.get(key);
        const exp = typeof entry === 'object' ? entry?.expiresAt : entry;
        if (!exp || exp < Date.now()) {
          if (entry) this.pinSecurity.verifiedSessions.delete(key);
          return false;
        }
        return true;
      }

      getPinAuthToken(sessionToken, restaurantId) {
        const entry = this.pinSecurity.verifiedSessions.get(`${sessionToken}::${restaurantId}`);
        return (typeof entry === 'object' && entry?.pinToken) ? entry.pinToken : '';
      }

      async updateOwnerPin(sessionToken, currentPin, newPin, activeRestaurantId) {
        const user = await this.authorize(sessionToken, 'manageSettings', true);
        if (!/^\d{6}$/.test(newPin)) {
          throw new Error('New PIN must be exactly 6 numeric digits.');
        }
        await this.verifyOwnerPin(sessionToken, currentPin, activeRestaurantId);
        const restaurant = await DB.getById('restaurants', activeRestaurantId || user.restaurantId);
        const newSalt = CryptoUtils.generateId('PINSALT');
        restaurant.pinSalt = newSalt;
        restaurant.ownerPinHash = await this.hashWithSalt(newSalt, newPin);
        restaurant.requiresDefaultPinChange = false;
        await DB.put('restaurants', restaurant);
        await this.logAudit(user.name, user.role, 'OWNER_PIN_UPDATED', 'restaurants', restaurant.id, 'Updated 6-digit salted SHA-256 PIN');
        return true;
      }

      /**
       * AUTHORITATIVE CUSTOMER ORDER INGESTION & IDEMPOTENT SYNC
       * - Validates & maps restaurantId strictly (never defaults unknown stores to Visamo)
       * - Deduplicates by unique orderId
       * - Persists order, orderItems & immutable financial snapshot atomically
       */
      async ingestAuthoritativeCustomerOrder(rawOrderPayload) {
        if (!rawOrderPayload || typeof rawOrderPayload !== 'object') {
          throw new Error('400 Bad Request: Invalid customer order payload.');
        }

        const orderId = String(rawOrderPayload.orderId || rawOrderPayload.id || '').trim();
        if (!orderId) {
          throw new Error('400 Bad Request: Unique orderId is required.');
        }

        // Strict restaurant resolution — never silently fallback to Visamo
        const candidateRestaurant =
          rawOrderPayload.restaurantId ||
          rawOrderPayload.storeId ||
          rawOrderPayload.items?.[0]?.storeId ||
          rawOrderPayload.items?.[0]?.storeName;

        const resolvedRestaurantId = resolveAuthoritativeRestaurantId(candidateRestaurant);
        if (!resolvedRestaurantId) {
          await this.logAudit(
            'Customer Sync Gate',
            'SYSTEM',
            'UNMAPPED_RESTAURANT_REJECTED',
            'orders',
            orderId,
            `Rejected order with unknown restaurant identifier: "${candidateRestaurant || 'MISSING'}"`
          );
          throw new Error(`422 Unprocessable Order: Unmapped restaurant identifier "${candidateRestaurant || 'MISSING'}" for order #${orderId}.`);
        }

        // Idempotent check: return existing order without duplicating
        const existingOrder = await DB.getById('orders', orderId);
        if (existingOrder) {
          return { order: existingOrder, duplicate: true };
        }

        const rawItems = Array.isArray(rawOrderPayload.items) ? rawOrderPayload.items : [];
        if (rawItems.length === 0) {
          throw new Error(`400 Bad Request: Order #${orderId} contains no items.`);
        }

        const orderItems = rawItems.map((it, idx) => {
          const qty = Math.max(1, Number(it.qty || 1));
          const unitPrice = Math.round(Number(it.unitPrice ?? it.price ?? 0) * 100) / 100;
          const lineTotal = Math.round(unitPrice * qty * 100) / 100;
          return {
            id: `OI-${orderId}-${idx + 1}`,
            orderId,
            productId: it.productId || `item-${idx + 1}`,
            name: String(it.name || 'Menu Item'),
            qty,
            unitPrice,
            variant: it.variant || 'Standard',
            addons: Array.isArray(it.addons) ? it.addons : [],
            lineTotal
          };
        });

        const foodSubtotal = Math.round(orderItems.reduce((sum, it) => sum + it.lineTotal, 0) * 100) / 100;
        if (foodSubtotal <= 0) {
          throw new Error(`400 Bad Request: Order #${orderId} subtotal must be greater than ₹0.`);
        }

        const financials = this.calculateOrderFinancials(foodSubtotal);
        const createdAt = Number(rawOrderPayload.createdAt || Date.now());
        const statusMap = {
          'Delivered': 'COMPLETED',
          'COMPLETED': 'COMPLETED',
          'Cancelled': 'CANCELLED',
          'CANCELLED': 'CANCELLED',
          'Rejected': 'REJECTED',
          'REJECTED': 'REJECTED',
          'Refunded': 'REFUNDED',
          'REFUNDED': 'REFUNDED'
        };
        const normalizedStatus = statusMap[rawOrderPayload.status] || 'NEW';

        const orderRecord = {
          id: orderId,
          restaurantId: resolvedRestaurantId,
          status: normalizedStatus,
          createdAt,
          completedAt: normalizedStatus === 'COMPLETED' ? (rawOrderPayload.completedAt || createdAt) : null,
          customerName: rawOrderPayload.customerName || 'Radhanpur Customer',
          customerPhone: rawOrderPayload.customerPhone || '+91 98752 99621',
          deliveryType: rawOrderPayload.deliveryType || 'DELIVERY',
          deliveryAddress: rawOrderPayload.deliveryAddress || rawOrderPayload.landmark || 'Radhanpur 385340',
          paymentMethod: rawOrderPayload.paymentMethod || 'UPI Instant Pay',
          paymentStatus: normalizedStatus === 'REFUNDED' || normalizedStatus === 'CANCELLED' ? 'REFUNDED' : 'PAID',
          specialInstructions: rawOrderPayload.specialInstructions || '',
          prepTimeMinutes: Number(rawOrderPayload.prepTimeMinutes || 20),
          foodSubtotal,
          customerPlatformFee: financials.customerPlatformFee,
          customerPayable: financials.customerPayable,
          restaurantCommission: financials.restaurantCommission,
          restaurantSettlement: financials.restaurantSettlement,
          payoutStatus: normalizedStatus === 'COMPLETED' ? 'PENDING' : 'VOID',
          timeline: [
            {
              status: 'NEW',
              label: 'Order Received from Zatpatgo Central Backend',
              timestamp: createdAt,
              actor: rawOrderPayload.customerName || 'Customer App'
            }
          ],
          items: orderItems,
          autoAccepted: false
        };

        await DB.put('orders', orderRecord);
        await DB.bulkPut('orderItems', orderItems);

        // Save immutable historical financial snapshot (never overwrite if already exists)
        const existingSnap = await DB.getById('orderFinancialSnapshots', `SNAP-${orderId}`);
        if (!existingSnap) {
          await DB.put('orderFinancialSnapshots', {
            id: `SNAP-${orderId}`,
            orderId,
            restaurantId: resolvedRestaurantId,
            createdAt,
            status: normalizedStatus,
            payoutStatus: normalizedStatus === 'COMPLETED' ? 'PENDING' : 'VOID',
            payoutRef: null,
            ...financials
          });
        }

        await this.createNotification({
          restaurantId: resolvedRestaurantId,
          title: `New Customer Order #${orderId}`,
          message: `${orderRecord.customerName} placed an order worth ${formatCurrency(foodSubtotal)}.`,
          category: 'ORDER',
          severity: 'INFO',
          orderId
        });

        await this.logAudit('Central Backend', 'SYSTEM', 'CUSTOMER_ORDER_SYNCED', 'orders', orderId, `Restaurant: ${resolvedRestaurantId} | Subtotal: ${formatCurrency(foodSubtotal)}`);
        RealtimeBus.publish('ORDER_UPDATED', orderRecord, `SYNC-${orderId}`);
        return { order: orderRecord, duplicate: false };
      }

      /**
       * PULL CENTRAL BACKEND ORDERS FOR RESTAURANT & RECONCILE ANY PENDING BRIDGE PAYLOADS
       */
      async pullOrdersFromCentralBackend(sessionToken, restaurantId) {
        if (!restaurantId) return 0;

        // 1. Primary: Query central REST API when hosted backend is connected
        const remote = await SharedApi.request(`/restaurants/${encodeURIComponent(restaurantId)}/orders`, {
          method: 'GET',
          sessionToken
        });
        let importedCount = 0;

        if (remote.remoteHandled && Array.isArray(remote.data?.orders)) {
          for (const remoteOrd of remote.data.orders) {
            try {
              const res = await this.ingestAuthoritativeCustomerOrder({
                ...remoteOrd,
                restaurantId: remoteOrd.restaurantId || restaurantId
              });
              if (!res.duplicate) importedCount += 1;
            } catch (_) {}
          }
        }

        // 2. Same-origin / embedded PWA bridge fallback (skips seed demo ZTG-8412)
        try {
          const rawCustomerOrders = JSON.parse(localStorage.getItem('zatpatgo_orders_v2') || '[]');
          if (Array.isArray(rawCustomerOrders)) {
            for (const cOrd of rawCustomerOrders) {
              const ordId = cOrd.orderId || cOrd.id;
              if (!ordId || ordId === 'ZTG-8412') continue;
              const mappedId = resolveAuthoritativeRestaurantId(
                cOrd.restaurantId || cOrd.storeId || cOrd.items?.[0]?.storeId || cOrd.items?.[0]?.storeName
              );
              if (!mappedId || mappedId !== restaurantId) continue;
              const res = await this.ingestAuthoritativeCustomerOrder({
                ...cOrd,
                restaurantId: mappedId
              });
              if (!res.duplicate) importedCount += 1;
            }
          }
        } catch (_) {}

        return importedCount;
      }

      /**
       * RECONCILE MISSING ORDER FINANCIAL SNAPSHOTS (SAFE, NON-DESTRUCTIVE)
       * Never overwrites an existing valid historical financial snapshot.
       */
      async reconcileMissingSnapshots(sessionToken, restaurantId) {
        const owner = await this.authorize(sessionToken, 'accessFinancials', true);
        if (!this.isPinSessionVerified(sessionToken, restaurantId)) {
          throw new Error('403 PIN Verification Required: Unlock Owner PIN before reconciling snapshots.');
        }

        const [allOrders, allSnapshots, allOrderItems] = await Promise.all([
          DB.getAll('orders'),
          DB.getAll('orderFinancialSnapshots'),
          DB.getAll('orderItems')
        ]);

        const restOrders = allOrders.filter(o => o.restaurantId === restaurantId);
        const snapByOrderId = new Map(allSnapshots.map(s => [s.orderId, s]));
        let reconciledCount = 0;

        for (const ord of restOrders) {
          const existingSnap = snapByOrderId.get(ord.id);
          if (
            existingSnap &&
            typeof existingSnap.foodSubtotal === 'number' &&
            typeof existingSnap.restaurantSettlement === 'number'
          ) {
            continue; // Never overwrite existing valid snapshot
          }

          // Reconstruct original foodSubtotal from immutable recorded line items
          const recordedItems = allOrderItems.filter(oi => oi.orderId === ord.id);
          const sourceItems = recordedItems.length > 0 ? recordedItems : (ord.items || []);
          const originalSubtotal = Math.round(
            sourceItems.reduce((sum, it) => sum + Number(it.unitPrice || 0) * Number(it.qty || 1), 0) * 100
          ) / 100;

          const financials = this.calculateOrderFinancials(originalSubtotal);
          const isVoid = ['CANCELLED', 'REJECTED', 'REFUNDED'].includes(ord.status);

          const newSnapshot = {
            id: `SNAP-${ord.id}`,
            orderId: ord.id,
            restaurantId: ord.restaurantId,
            createdAt: ord.createdAt,
            status: ord.status,
            payoutStatus: isVoid ? 'VOID' : (ord.payoutStatus || (ord.status === 'COMPLETED' ? 'PENDING' : 'VOID')),
            payoutRef: ord.payoutRef || null,
            reconciledAt: Date.now(),
            ...financials
          };

          await DB.put('orderFinancialSnapshots', newSnapshot);
          reconciledCount += 1;
        }

        await this.logAudit(
          owner.name,
          owner.role,
          'SNAPSHOTS_RECONCILED',
          'orderFinancialSnapshots',
          restaurantId,
          `Reconciled ${reconciledCount} missing financial snapshot(s)`
        );

        return { reconciledCount };
      }

      /**
       * OWNER-ONLY FINANCIAL & SETTLEMENT ENDPOINT (AUTHORITATIVE SNAPSHOT PIPELINE)
       */
      async getFinancialDashboardData(sessionToken, restaurantId) {
        const owner = await this.authorize(sessionToken, 'accessFinancials', true);
        if (!restaurantId) {
          throw new Error('400 Bad Request: Restaurant ID is required.');
        }
        if (!this.isPinSessionVerified(sessionToken, restaurantId)) {
          throw new Error('403 PIN Verification Required: Verify your 6-digit Owner PIN.');
        }

        // Pull latest orders from central backend first
        await this.pullOrdersFromCentralBackend(sessionToken, restaurantId);

        // Query central backend financial endpoint if available
        const remote = await SharedApi.request(`/restaurants/${encodeURIComponent(restaurantId)}/financials`, {
          method: 'GET',
          sessionToken,
          pinToken: this.getPinAuthToken(sessionToken, restaurantId)
        });
        if (remote.remoteHandled && remote.data && Array.isArray(remote.data.records)) {
          return remote.data;
        }

        const [allOrders, allSnapshots, allSettlements, allSettlementTxns] = await Promise.all([
          DB.getAll('orders'),
          DB.getAll('orderFinancialSnapshots'),
          DB.getAll('settlements'),
          DB.getAll('settlementTransactions')
        ]);

        // Deduplicate by unique order.id and enforce strict restaurantId isolation
        const orderMap = new Map();
        for (const o of allOrders) {
          if (o.restaurantId === restaurantId && !orderMap.has(o.id)) {
            orderMap.set(o.id, o);
          }
        }
        const restaurantOrders = Array.from(orderMap.values()).sort((a, b) => b.createdAt - a.createdAt);

        const snapMap = new Map();
        for (const s of allSnapshots) {
          if (s.restaurantId === restaurantId && !snapMap.has(s.orderId)) {
            snapMap.set(s.orderId, s);
          }
        }

        const missingSnapshotOrderIds = [];
        const enrichedRecords = restaurantOrders.map(ord => {
          const snap = snapMap.get(ord.id) || null;
          if (!snap) {
            missingSnapshotOrderIds.push(ord.id);
          }
          return {
            order: ord,
            snapshot: snap,
            hasSnapshot: !!snap
          };
        });

        const restaurantSettlements = allSettlements
          .filter(s => s.restaurantId === restaurantId)
          .sort((a, b) => b.settlementDate - a.settlementDate);

        const settlementIds = new Set(restaurantSettlements.map(s => s.id));
        const restaurantTransactions = allSettlementTxns
          .filter(t => settlementIds.has(t.settlementId))
          .sort((a, b) => b.timestamp - a.timestamp);

        return {
          restaurantId,
          fetchedAt: Date.now(),
          records: enrichedRecords,
          missingSnapshotOrderIds,
          settlements: restaurantSettlements,
          settlementTransactions: restaurantTransactions
        };
      }

      /**
       * INCOMING CUSTOMER ORDER ENTRYPOINT & 7-RULE AUTOMATIC ACCEPTANCE ENGINE
       */
      async receiveIncomingCustomerOrder({ restaurantId, customerName, customerPhone, deliveryType, deliveryAddress, paymentMethod, specialInstructions, items, orderId: providedOrderId }) {
        const resolvedRestId = resolveAuthoritativeRestaurantId(restaurantId);
        if (!resolvedRestId) {
          throw new Error(`422 Unprocessable Order: Unknown or unmapped restaurantId "${restaurantId || 'MISSING'}".`);
        }

        if (providedOrderId) {
          const dup = await DB.getById('orders', providedOrderId);
          if (dup) return dup;
        }

        const settings = await DB.getById('restaurantSettings', `SET-${resolvedRestId}`);
        const autoSettings = await DB.getById('orderAutomationSettings', `AUTO-${resolvedRestId}`);
        const allProducts = await DB.getAll('products');
        const allOrders = await DB.getAll('orders');

        // Rule 1: Restaurant online status check
        if (!settings.isOnline || settings.holidayMode) {
          throw new Error(`Kitchen is currently OFFLINE (${settings.offlineReason || 'Holiday / Closed'}). Cannot accept new customer orders.`);
        }

        // Validate items, stock & compute authoritative foodSubtotal
        const orderItems = [];
        let foodSubtotal = 0;
        let stockValid = true;
        let stockReason = '';

        for (const reqItem of items) {
          const prod = allProducts.find(p => p.id === reqItem.productId);
          if (!prod) throw new Error(`Product ${reqItem.productId} does not exist.`);
          if (!prod.available || prod.stock < reqItem.qty) {
            stockValid = false;
            stockReason = `${prod.name} insufficient stock (${prod.stock} left, ${reqItem.qty} requested)`;
          }
          const lineTotal = Math.round(prod.price * reqItem.qty * 100) / 100;
          foodSubtotal += lineTotal;
          orderItems.push({
            productId: prod.id,
            name: prod.name,
            qty: reqItem.qty,
            unitPrice: prod.price,
            variant: reqItem.variant || (prod.variants?.[0] || 'Standard'),
            addons: reqItem.addons || [],
            lineTotal
          });
        }

        foodSubtotal = Math.round(foodSubtotal * 100) / 100;
        const financials = this.calculateOrderFinancials(foodSubtotal);

        const now = Date.now();
        const isBusyActive = settings.busyMode?.enabled && (!settings.busyMode.expiresAt || settings.busyMode.expiresAt > now);
        const maxItemPrep = Math.max(...orderItems.map(oi => {
          const p = allProducts.find(prod => prod.id === oi.productId);
          return p ? p.prepTime : autoSettings.defaultPrepTimeMinutes;
        }));
        const busyExtra = isBusyActive ? Number(settings.busyMode.extraPrepMinutes || 12) : 0;
        const calculatedPrepTime = Math.min(
          autoSettings.maxEstimatedPrepTimeMinutes,
          Math.max(autoSettings.defaultPrepTimeMinutes, maxItemPrep) + busyExtra
        );

        const restOrders = allOrders.filter(o => o.restaurantId === resolvedRestId);
        const activeStatuses = ['NEW', 'ACCEPTED', 'PREPARING', 'READY'];
        const activeOrdersCount = restOrders.filter(o => activeStatuses.includes(o.status)).length;
        const lastHourCount = restOrders.filter(o => o.createdAt >= now - 3600000).length;

        const effectiveMaxCapacity = isBusyActive
          ? Math.min(autoSettings.maxSimultaneousOrders, settings.busyMode.reducedMaxOrders)
          : autoSettings.maxSimultaneousOrders;

        // Evaluate 7-point Automatic Acceptance Criteria
        let autoAccepted = false;
        let autoSkipReason = '';

        if (autoSettings.autoAcceptEnabled) {
          if (!settings.isOnline) {
            autoSkipReason = 'Kitchen offline';
          } else if (isBusyActive && settings.busyMode.pauseNewOrders) {
            autoSkipReason = 'Busy Mode paused auto-accept';
          } else if (!stockValid) {
            autoSkipReason = stockReason;
          } else if (activeOrdersCount >= effectiveMaxCapacity) {
            autoSkipReason = `Max simultaneous orders reached (${activeOrdersCount}/${effectiveMaxCapacity})`;
          } else if (lastHourCount >= autoSettings.maxOrdersPerHour) {
            autoSkipReason = `Hourly order limit reached (${lastHourCount}/${autoSettings.maxOrdersPerHour})`;
          } else if (calculatedPrepTime > autoSettings.maxEstimatedPrepTimeMinutes) {
            autoSkipReason = 'Prep estimate exceeds configured cap';
          } else {
            autoAccepted = true;
          }
        }

        const orderId = providedOrderId || `ZTG-${Math.floor(1000 + Math.random() * 9000)}`;
        const initialStatus = autoAccepted ? 'ACCEPTED' : 'NEW';

        const timeline = [
          { status: 'NEW', label: 'Order Placed via Zatpatgo Customer App', timestamp: now, actor: customerName }
        ];

        if (autoAccepted) {
          timeline.push({
            status: 'ACCEPTED',
            label: `Auto-Accepted by Zatpatgo Engine (Est. ${calculatedPrepTime}m)`,
            timestamp: now + 100,
            actor: 'Zatpatgo Auto-Mode'
          });
          await this._deductStockForItems(resolvedRestId, orderItems, orderId, 'Auto-Accept Stock Reservation', autoSettings.autoMarkOutOfStockAtZero);
        }

        const newOrder = {
          id: orderId,
          restaurantId: resolvedRestId,
          status: initialStatus,
          createdAt: now,
          acceptedAt: autoAccepted ? now + 100 : null,
          customerName,
          customerPhone,
          deliveryType: deliveryType || 'DELIVERY',
          deliveryAddress: deliveryAddress || 'Near Highway Char Rasta, Radhanpur 385340',
          paymentMethod: paymentMethod || 'UPI Instant Pay',
          paymentStatus: 'PAID',
          specialInstructions: specialInstructions || '',
          prepTimeMinutes: calculatedPrepTime,
          foodSubtotal,
          customerPlatformFee: financials.customerPlatformFee,
          customerPayable: financials.customerPayable,
          restaurantCommission: financials.restaurantCommission,
          restaurantSettlement: financials.restaurantSettlement,
          timeline,
          items: orderItems,
          autoAccepted
        };

        await DB.put('orders', newOrder);
        await DB.put('orderFinancialSnapshots', {
          id: `SNAP-${orderId}`,
          orderId,
          restaurantId: resolvedRestId,
          createdAt: now,
          status: initialStatus,
          payoutStatus: 'VOID',
          payoutRef: null,
          ...financials
        });

        for (const [idx, item] of orderItems.entries()) {
          await DB.put('orderItems', {
            id: `OI-${orderId}-${idx + 1}`,
            orderId,
            ...item
          });
        }

        await SharedApi.request('/orders', {
          method: 'POST',
          idempotencyKey: orderId,
          body: { order: newOrder, snapshot: financials }
        });

        await this.createNotification({
          restaurantId: resolvedRestId,
          title: autoAccepted ? `Auto-Accepted Order #${orderId}` : `New Order #${orderId} Waiting`,
          message: autoAccepted
            ? `${customerName} (${formatCurrency(foodSubtotal)}) accepted automatically.`
            : `${customerName} placed an order worth ${formatCurrency(foodSubtotal)}${autoSkipReason ? ` (${autoSkipReason})` : ''}.`,
          category: 'ORDER',
          severity: 'INFO',
          orderId
        });

        await this.logAudit('Customer App', 'CUSTOMER', 'ORDER_CREATED', 'orders', orderId, `Subtotal ${formatCurrency(foodSubtotal)} | AutoAccepted: ${autoAccepted}`);
        SharedApi.broadcastStatusToCustomerApp(newOrder);
        RealtimeBus.publish('ORDER_UPDATED', newOrder, `CREATE-${orderId}`);
        return newOrder;
      }

      /**
       * ORDER LIFECYCLE STATE TRANSITIONS (WITH SERVER-SIDE PERMISSION CHECKS)
       */
      async transitionOrderStatus(sessionToken, orderId, targetStatus, payload = {}) {
        const permMap = {
          ACCEPTED: 'acceptOrders',
          REJECTED: 'acceptOrders',
          PREPARING: 'updateKitchenStatus',
          READY: 'updateKitchenStatus',
          ON_THE_WAY: 'manageOrders',
          COMPLETED: 'manageOrders',
          CANCELLED: 'manageOrders',
          REFUNDED: 'accessFinancials'
        };
        const actor = await this.authorize(sessionToken, permMap[targetStatus] || 'manageOrders', targetStatus === 'REFUNDED');

        const order = await DB.getById('orders', orderId);
        if (!order) throw new Error(`Order ${orderId} not found.`);

        const autoSettings = await DB.getById('orderAutomationSettings', `AUTO-${order.restaurantId}`);
        const now = Date.now();

        const allowed = {
          NEW: ['ACCEPTED', 'REJECTED', 'CANCELLED'],
          ACCEPTED: ['PREPARING', 'CANCELLED'],
          PREPARING: ['READY', 'CANCELLED'],
          READY: ['ON_THE_WAY', 'COMPLETED', 'CANCELLED'],
          ON_THE_WAY: ['COMPLETED', 'CANCELLED'],
          COMPLETED: ['REFUNDED'],
          CANCELLED: [],
          REJECTED: []
        };

        if (!allowed[order.status]?.includes(targetStatus)) {
          throw new Error(`Invalid transition from ${order.status} to ${targetStatus}.`);
        }

        if (targetStatus === 'ACCEPTED') {
          const allProducts = await DB.getAll('products');
          for (const item of order.items) {
            const prod = allProducts.find(p => p.id === item.productId);
            if (prod && prod.stock < item.qty) {
              throw new Error(`Insufficient stock for ${prod.name} (${prod.stock} left). Restock or reject order.`);
            }
          }
          order.acceptedAt = now;
          if (payload.prepTimeMinutes) order.prepTimeMinutes = Number(payload.prepTimeMinutes);
          await this._deductStockForItems(order.restaurantId, order.items, order.id, `Accepted #${order.id}`, autoSettings?.autoMarkOutOfStockAtZero ?? true);
          order.timeline.push({
            status: 'ACCEPTED',
            label: `Order Accepted (Est. Prep: ${order.prepTimeMinutes}m)`,
            timestamp: now,
            actor: `${actor.name} (${actor.roleLabel})`
          });
        }

        if (targetStatus === 'REJECTED' || targetStatus === 'CANCELLED') {
          const wasAccepted = ['ACCEPTED', 'PREPARING', 'READY', 'ON_THE_WAY'].includes(order.status);
          if (wasAccepted) {
            await this._restoreStockForItems(order.restaurantId, order.items, order.id, `Restored from ${targetStatus} #${order.id}`);
          }
          order.cancelledAt = now;
          order.cancelReason = payload.reason || 'Rejected by restaurant';
          order.paymentStatus = 'REFUNDED';
          order.timeline.push({
            status: targetStatus,
            label: `${targetStatus === 'REJECTED' ? 'Rejected' : 'Cancelled'}: ${order.cancelReason}`,
            timestamp: now,
            actor: `${actor.name} (${actor.roleLabel})`
          });
          await this.createNotification({
            restaurantId: order.restaurantId,
            title: `Order #${order.id} ${targetStatus === 'REJECTED' ? 'Rejected' : 'Cancelled'}`,
            message: order.cancelReason,
            category: 'ORDER',
            severity: 'WARNING',
            orderId: order.id
          });
        }

        if (targetStatus === 'PREPARING') {
          order.preparingAt = now;
          order.timeline.push({
            status: 'PREPARING',
            label: 'Kitchen Started Preparing Food',
            timestamp: now,
            actor: `${actor.name} (${actor.roleLabel})`
          });
        }

        if (targetStatus === 'READY') {
          order.readyAt = now;
          if (order.deliveryType === 'DELIVERY' && !order.deliveryPartner) {
            const rider = DELIVERY_RIDERS[Math.floor(Math.random() * DELIVERY_RIDERS.length)];
            order.deliveryPartner = rider;
            await DB.put('deliveryAssignments', {
              id: CryptoUtils.generateId('DEL'),
              orderId: order.id,
              restaurantId: order.restaurantId,
              riderId: rider.id,
              riderName: rider.name,
              riderPhone: rider.phone,
              vehicle: rider.vehicle,
              assignedAt: now,
              status: 'ASSIGNED_FOR_PICKUP'
            });
            await this.createNotification({
              restaurantId: order.restaurantId,
              title: `Delivery Partner Assigned (#${order.id})`,
              message: `${rider.name} (${rider.vehicle}) arriving for pickup.`,
              category: 'DELIVERY',
              severity: 'INFO',
              orderId: order.id
            });
          }
          order.timeline.push({
            status: 'READY',
            label: order.deliveryType === 'PICKUP'
              ? 'Order Ready at Pickup Counter'
              : `Food Ready • Partner ${order.deliveryPartner?.name || 'Assigned'}`,
            timestamp: now,
            actor: `${actor.name} (${actor.roleLabel})`
          });
        }

        if (targetStatus === 'ON_THE_WAY') {
          order.onTheWayAt = now;
          order.timeline.push({
            status: 'ON_THE_WAY',
            label: `Handed Over to ${order.deliveryPartner?.name || 'Delivery Partner'}`,
            timestamp: now,
            actor: `${actor.name} (${actor.roleLabel})`
          });
        }

        if (targetStatus === 'COMPLETED') {
          order.completedAt = now;
          order.payoutStatus = 'PENDING';
          order.timeline.push({
            status: 'COMPLETED',
            label: `Delivered & Settled (${formatCurrency(order.restaurantSettlement)})`,
            timestamp: now,
            actor: `${actor.name} (${actor.roleLabel})`
          });
        }

        if (targetStatus === 'REFUNDED') {
          order.refundedAt = now;
          order.paymentStatus = 'REFUNDED';
          order.payoutStatus = 'ADJUSTED';
          order.timeline.push({
            status: 'REFUNDED',
            label: `Refund Processed (${formatCurrency(order.customerPayable)})`,
            timestamp: now,
            actor: `${actor.name} (${actor.roleLabel})`
          });
        }

        order.status = targetStatus;
        await DB.put('orders', order);

        const snap = await DB.getById('orderFinancialSnapshots', `SNAP-${order.id}`);
        if (snap) {
          snap.status = targetStatus;
          if (targetStatus === 'COMPLETED') snap.payoutStatus = 'PENDING';
          if (['CANCELLED', 'REJECTED', 'REFUNDED'].includes(targetStatus)) snap.payoutStatus = 'VOID';
          await DB.put('orderFinancialSnapshots', snap);
        }

        // Propagate status update to Central Backend API & Customer PWA
        await SharedApi.request(`/orders/${encodeURIComponent(order.id)}/status`, {
          method: 'PATCH',
          sessionToken,
          idempotencyKey: `${order.id}-${targetStatus}-${now}`,
          body: {
            restaurantId: order.restaurantId,
            status: targetStatus,
            prepTimeMinutes: order.prepTimeMinutes,
            deliveryPartner: order.deliveryPartner || null,
            cancelReason: order.cancelReason || null
          }
        });
        SharedApi.broadcastStatusToCustomerApp(order);

        await this.logAudit(actor.name, actor.role, `ORDER_${targetStatus}`, 'orders', order.id, `Status -> ${targetStatus}`);
        RealtimeBus.publish('ORDER_UPDATED', order, `STATUS-${order.id}-${targetStatus}`);
        return order;
      }

