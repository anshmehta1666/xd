    function ensureIosHapticSwitch() {
      if (iosSwitchLabel || typeof document === 'undefined' || !document.body) return iosSwitchLabel;
      const input = document.createElement('input');
      input.type = 'checkbox';
      input.setAttribute('switch', '');
      input.id = 'ztg-partner-ios-haptic';
      input.tabIndex = -1;
      input.setAttribute('aria-hidden', 'true');
      input.style.cssText = 'position:fixed;top:-9999px;left:-9999px;width:1px;height:1px;opacity:0;pointer-events:none;';
      const label = document.createElement('label');
      label.htmlFor = input.id;
      label.setAttribute('aria-hidden', 'true');
      label.style.cssText = 'position:fixed;top:-9999px;left:-9999px;width:1px;height:1px;opacity:0;pointer-events:none;';
      document.body.appendChild(input);
      document.body.appendChild(label);
      iosSwitchLabel = label;
      return iosSwitchLabel;
