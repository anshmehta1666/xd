    /**
     * =========================================================================
     * 3. REAL-TIME PUB/SUB EVENT BUS (BroadcastChannel('zatpatgo_live_bus_385340'))
     * =========================================================================
     */
    class ZatpatgoRealtimeBus {
      constructor() {
        this.listeners = new Map();
        this.processedEventIds = new Set();
        this.channel = typeof BroadcastChannel !== 'undefined' ? new BroadcastChannel('zatpatgo_live_bus_385340') : null;
        if (this.channel) {
          this.channel.onmessage = (event) => {
            if (event.data && event.data.type) {
              this._dispatchLocal(event.data.type, event.data.payload, event.data.eventId);
            }
          };
        }
      }

      subscribe(eventType, callback) {
        if (!this.listeners.has(eventType)) this.listeners.set(eventType, new Set());
        this.listeners.get(eventType).add(callback);
        return () => this.listeners.get(eventType)?.delete(callback);
      }

      publish(eventType, payload, eventId = CryptoUtils.generateId('EVT')) {
        if (this.processedEventIds.has(eventId)) return; // Duplicate-event protection
        this._dispatchLocal(eventType, payload, eventId);
        if (this.channel) {
          try {
            this.channel.postMessage({ type: eventType, payload, eventId });
          } catch (_) {}
        }
      }

      _dispatchLocal(eventType, payload, eventId) {
        if (eventId) {
          if (this.processedEventIds.has(eventId)) return;
          this.processedEventIds.add(eventId);
          if (this.processedEventIds.size > 600) {
            const first = this.processedEventIds.values().next().value;
            this.processedEventIds.delete(first);
          }
        }
        this.listeners.get(eventType)?.forEach(cb => {
          try { cb(payload); } catch (e) {}
        });
        this.listeners.get('*')?.forEach(cb => {
          try { cb({ type: eventType, payload }); } catch (e) {}
        });
      }
    }

