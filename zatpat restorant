    const CustomerOrderSimulatorModal = ({ open, onClose, restaurantId, restaurantName, products, onOrderCreated }) => {
      const kitchenProducts = products.filter(p => p.restaurantId === restaurantId);
      const [customerName, setCustomerName] = useState('Rohan Mehta');
      const [customerPhone, setCustomerPhone] = useState('+91 98250 61420');
      const [deliveryType, setDeliveryType] = useState('DELIVERY');
      const [deliveryAddress, setDeliveryAddress] = useState('14, Shantinagar Society, Radhanpur 385340');
      const [specialInstructions, setSpecialInstructions] = useState('');
      const [selectedQuantities, setSelectedQuantities] = useState({});
      const [submitting, setSubmitting] = useState(false);

      useEffect(() => {
        if (open && kitchenProducts.length > 0) {
          const initial = {};
          initial[kitchenProducts[0].id] = 1;
          setSelectedQuantities(initial);
        }
      }, [open, restaurantId]);

      const selectedItems = kitchenProducts
        .filter(p => (selectedQuantities[p.id] || 0) > 0)
        .map(p => ({
          productId: p.id,
          name: p.name,
          qty: selectedQuantities[p.id],
          unitPrice: p.price
        }));

      const foodSubtotal = selectedItems.reduce((sum, i) => sum + i.unitPrice * i.qty, 0);
      const previewFinancials = Backend.calculateOrderFinancials(foodSubtotal);

      const applyPresetAmount = (targetSubtotal) => {
        const match = kitchenProducts.find(p => p.price === targetSubtotal);
        if (match) {
          setSelectedQuantities({ [match.id]: 1 });
          return;
        }
        if (targetSubtotal === 200 && kitchenProducts.length > 0) {
          const p100 = kitchenProducts.find(p => p.price === 100);
          if (p100) {
            setSelectedQuantities({ [p100.id]: 2 });
            return;
          }
        }
        if (targetSubtotal === 500 && kitchenProducts.length >= 3) {
          const thali = kitchenProducts.find(p => p.price === 240);
          const shrikhand = kitchenProducts.find(p => p.price === 130);
          if (thali && shrikhand) {
            setSelectedQuantities({ [thali.id]: 1, [shrikhand.id]: 2 });
            return;
          }
        }
        if (kitchenProducts[0]) {
          setSelectedQuantities({ [kitchenProducts[0].id]: 1 });
        }
      };

      const handlePlaceSimulatedOrder = async (e) => {
        e.preventDefault();
        if (selectedItems.length === 0) return;
        setSubmitting(true);
        try {
          const created = await Backend.receiveIncomingCustomerOrder({
            restaurantId,
            customerName,
            customerPhone,
            deliveryType,
            deliveryAddress,
            paymentMethod: 'UPI Instant Pay',
            specialInstructions,
            items: selectedItems
          });
          triggerHaptic();
          onOrderCreated(created, null);
          onClose();
        } catch (err) {
          onOrderCreated(null, err.message);
        } finally {
          setSubmitting(false);
        }
      };

      return (
        <Modal
          open={open}
          onClose={onClose}
          title={`Simulate Customer Order • ${restaurantName || ''}`}
          subtitle="Dispatches a real order through ZatpatgoBackendService & RealtimeBus"
          maxWidth="max-w-xl"
        >
          <form onSubmit={handlePlaceSimulatedOrder} className="space-y-4">
            {/* Quick Fee-Rule Test Presets */}
            <div>
              <span className="block text-[10px] font-extrabold uppercase tracking-wider text-brand-muted mb-1.5">
                Quick Fee-Rule Test Presets
              </span>
              <div className="flex flex-wrap gap-1.5">
                {[60, 99, 100, 200, 500].map(amt => (
                  <button
                    key={amt}
                    type="button"
                    onClick={() => applyPresetAmount(amt)}
                    className="h-8 px-3 rounded-full bg-brand-canvas hover:bg-brand-purple hover:text-white border border-brand-hairline text-xs font-extrabold transition btn-tactile"
                  >
                    ₹{amt} Subtotal
                  </button>
                ))}
              </div>
            </div>

            {/* Menu Item Picker */}
            <div className="border border-brand-hairline rounded-2xl divide-y divide-brand-canvas max-h-48 overflow-y-auto">
              {kitchenProducts.map(prod => {
                const qty = selectedQuantities[prod.id] || 0;
                return (
                  <div key={prod.id} className="p-3 flex items-center justify-between gap-2 text-xs">
                    <div className="min-w-0">
                      <div className="font-bold text-brand-ink truncate">{prod.name}</div>
                      <div className="text-[11px] text-brand-muted">
                        {formatCurrency(prod.price)} • Stock: {prod.stock} {!prod.available ? '(Unavailable)' : ''}
                      </div>
                    </div>
                    <div className="flex items-center gap-2 shrink-0">
                      <button
                        type="button"
                        onClick={() => setSelectedQuantities({ ...selectedQuantities, [prod.id]: Math.max(0, qty - 1) })}
                        className="w-7 h-7 rounded-full bg-brand-canvas font-extrabold"
                      >−</button>
                      <span className="w-5 text-center font-editorial font-extrabold">{qty}</span>
                      <button
                        type="button"
                        onClick={() => setSelectedQuantities({ ...selectedQuantities, [prod.id]: qty + 1 })}
                        className="w-7 h-7 rounded-full bg-brand-purple text-white font-extrabold"
                      >+</button>
                    </div>
                  </div>
                );
              })}
            </div>

            <div className="grid grid-cols-2 gap-2.5">
              <div>
                <label className="block text-[10px] font-bold uppercase text-brand-muted mb-1">Customer Name</label>
                <input
                  type="text"
                  required
                  value={customerName}
                  onChange={(e) => setCustomerName(e.target.value)}
                  className="w-full h-10 px-3 rounded-xl bg-brand-canvas border border-brand-hairline text-xs font-bold"
                />
              </div>
              <div>
                <label className="block text-[10px] font-bold uppercase text-brand-muted mb-1">Fulfillment</label>
                <select
                  value={deliveryType}
                  onChange={(e) => setDeliveryType(e.target.value)}
                  className="w-full h-10 px-3 rounded-xl bg-brand-canvas border border-brand-hairline text-xs font-bold"
                >
                  <option value="DELIVERY">Delivery (Radhanpur 385340)</option>
                  <option value="PICKUP">Customer Self-Pickup</option>
                </select>
              </div>
            </div>

            <div>
              <label className="block text-[10px] font-bold uppercase text-brand-muted mb-1">Special Cooking Note (Optional)</label>
              <input
                type="text"
                value={specialInstructions}
                onChange={(e) => setSpecialInstructions(e.target.value)}
                placeholder="e.g. Less spicy, pack extra chutney"
                className="w-full h-10 px-3 rounded-xl bg-brand-canvas border border-brand-hairline text-xs"
              />
            </div>

            {/* Authoritative Fee Calculation Preview */}
            <div className="p-3.5 rounded-2xl bg-brand-deep text-white text-xs space-y-1">
              <div className="flex justify-between">
                <span className="text-white/75">Food Subtotal</span>
                <span className="font-bold">{formatCurrency(previewFinancials.foodSubtotal)}</span>
              </div>
              <div className="flex justify-between">
                <span className="text-white/75">Customer Platform Fee ({previewFinancials.foodSubtotal < 100 ? '₹15 flat' : '5%'})</span>
                <span>{formatCurrency(previewFinancials.customerPlatformFee)}</span>
              </div>
              <div className="flex justify-between">
                <span className="text-white/75">Restaurant Commission ({previewFinancials.foodSubtotal < 100 ? '0%' : '15%'})</span>
                <span className="text-brand-orange">-{formatCurrency(previewFinancials.restaurantCommission)}</span>
              </div>
              <div className="pt-1.5 border-t border-white/15 flex justify-between font-editorial font-extrabold text-sm text-brand-yellow">
                <span>Restaurant Net Settlement</span>
                <span>{formatCurrency(previewFinancials.restaurantSettlement)}</span>
              </div>
            </div>

            <button
              type="submit"
              disabled={submitting || selectedItems.length === 0}
              className="w-full h-12 rounded-2xl bg-brand-purple hover:bg-brand-deep text-white font-editorial font-extrabold text-sm shadow-pill btn-tactile disabled:opacity-50"
            >
              {submitting ? 'Dispatching Order...' : `Send Live Customer Order (${formatCurrency(previewFinancials.customerPayable)})`}
            </button>
          </form>
        </Modal>
      );
    };

    const root = ReactDOM.createRoot(document.getElementById('root'));
    root.render(<App />);
  </script>
</body>
</html>