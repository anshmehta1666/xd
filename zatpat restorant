                        onChange={(e) => setOtp(e.target.value.replace(/\D/g, ''))}
                        placeholder="••••••"
                        className="w-full h-12 px-4 rounded-2xl bg-brand-canvas border border-brand-hairline focus:border-brand-purple focus:bg-white focus:outline-none text-center tracking-[0.4em] font-editorial font-extrabold text-base text-brand-ink"
                      />
